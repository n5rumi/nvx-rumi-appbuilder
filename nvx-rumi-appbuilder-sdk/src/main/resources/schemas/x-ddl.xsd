<?xml-stylesheet type="text/xsl" href="http://build.neeveresearch.com/talon/schema/xs3p.xsl"?>
<xs:schema elementFormDefault="qualified" targetNamespace="http://www.neeveresearch.com/schema/x-ddl" version="1.4" xmlns="http://www.neeveresearch.com/schema/x-ddl" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="ChannelQos">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the different supported Qualities of Service.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="BestEffort">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies Best Effort quality of service. Messages sent Best Effort are not
                            acknowledged, and can be lost in the event of a failure.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Guaranteed">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies Guaranteed quality of service. Messages sent Guaranteed are held
                            until acknowledged by the downstream recipient. This quality of service
                            guaranteed at least once delivery of sent messages. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="InboundEventMultiplexerType">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the various types of inbound event multiplexers supported by an AEP engine.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="FreeThreadedSerialized">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                          Specifies the free threaded serialized inbound event multiplexer. A free threaded serialized 
                          multiplexer allows one and only one thread to dispatch events to the application at any point 
                          in time. However, across time, different threads can dispatch events to the application.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="DedicatedThreaded">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                          Specifies the dedicated threaded inbound event multiplexer. Such a multiplexer dispatched events 
                          to an application using a dedicated thread.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="InboundMessageLoggingPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that determine if and where to log inbound messages
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Off">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Disables inbound message logging.
                            <br />
                            This is the default policy.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="UseDedicated">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Use a dedicated log for inbound message logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="InboundMessageLoggingFailurePolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that specifies what to do in the event of an inbound message logging failure.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="StopLogging">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy specifies that inbound logging errors will be trapped and cause the engine to discontinue inbound message logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="StopEngine">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy specifies that a failure in inbound logging will be treated as a failure (that will result in service shutdown).
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="OutboundMessageLoggingPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that determine if and where to log outbound messages
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Off">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Disables outbound message logging.
                            <br />
                            This is the default policy.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="UseDedicated">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Use a dedicated log for outbound message logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="OutboundMessageLoggingFailurePolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates policies that specifies what to do in the event of an outbound message logging failure.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="StopLogging">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy specifies that outbound logging errors will be trapped and cause the engine to discontinue outbound message logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="StopEngine">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy specifies that a failure in outbound logging will be treated as a failure which will result in shutdown of the engine.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PerTransactionStatsLoggingPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that determines if and where to log a service's per transaction stats.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Off">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Disables per transaction stats logging.
                            <br />
                            This is the default policy.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="UseDedicated">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Use a dedicated log for per transaction stats logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PerTransactionStatsLoggingFailurePolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates policies that determine what to do in the event of a per transaction stats logging failure
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="StopLogging">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy specifies that per transaction stats logging errors will be trapped and cause the engine to discontinue per transaction stats logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="StopEngine">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy specifies that a failure in per transaction stats logging will be treated as a failure which will result in shutdown of the engine.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MessagingStartFailPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates policies that determine what action a service takes when it fails to start one or more of its messaging bus connections.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="NeverFail">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy causes a service's messaging start operation to be considered as successful as long as at least one 
                            connection attempt was successful or failed with a non-permanent exception (i.e, an exception that causes the 
                            service engine to retry the connection establishment)  
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="FailIfOneBindingFails">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy causes a service's messaging start operation to be considered as successful only if all connection
                            attempts were successful  
                            <p>
                            <i>This is the default messaging start fail policy</i> 
                            </p>
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="FailIfAllBindingsFail">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This policy causes a service's messaging start operation to be considered as successful if one or more connection
                            attempts is successful. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MessageBusBindingFailPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates policies that determine what action a service takes when a message bus connection fails.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Reconnect">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            With this policy, when a messaging connection fails, the service engine dispatches channel down events 
                            for all channels in the failed connection. It then starts the reconnect process on the failed connection
                            periodically retrying the connection. Channel up events are then dispatched for bus channels once the
                            connection to the messaging bus has been successfully reestablished. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="FailIfAnyBindingFails">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            With this policy, when a messaging connection fails, the service engine shuts down all other operational 
                            connections (if any) and dispatches a "messaging failed" event to the service. A connection shut down such 
                            is done so in a manner that preserves the channel interests on the message bus for all the guaranteed channels 
                            while the connection to thge bus is down. This ensures no message loss when the connection is reestablished at 
                            a later point. 
                            <p>
                            <i>This is the default messaging fail policy</i> 
                            </p>
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="InboundEventAcknowledgementPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates polcies that determine when a service acknowledges inbound messages to upstream message senders
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Default">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            With this policy, the engine selects the inbound event acknowledgement policy based on its configuration.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="OnSendStability">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            With this policy, inbound messages are acknowledged after acknowledgements have been received for all
                            outbound messages triggered by the processing of the inbound message.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="OnStoreStability">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            With this policy, inbound message are acknowledged once store commit of the transaction that contains the 
                            inbound message is complete. .
                            <br/> 
                            Note: This policy is currently in an experimental phase. It is not recommended for use in production
                            without guideance from support. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MessageHandlerExceptionHandlingPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that determines how the service engine handles unchecked exceptions thrown by a service message handler.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="LogExceptionAndContinue">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Log an exception and continue operating.
                            <br />
                            With this policy, upon receipt of an unchecked exception from an application's event/message
                            handler, the engine:
                            <ol>
                                <li>logs the exception received from the application</li>
                                <li>stops processing the message</li>
                                <li>acknowledges it</li>
                                <li>and continues to process new events queued for execution.</li>
                            </ol>
                            Essentially, with this policy, message processing stops where it is and from an HA standpoint the message is
                            removed from the processing stream.
                            <br />
                            <br />
                            When applied to an exception thrown from a message filter the message will not be dispatched to the service
                            event handlers.
                            <br />
                            <br />
                            In all cases the message will not be considered to be part of the transaction and is acknowledged upstream.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RollbackAndStop">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Stop the engine.
                            <br />
                            With this policy, upon receipt of an unchecked exception from an application handler, the service
                            engine performs the following:
                            <ol>
                                <li>
                                    Rolls back the transaction in which the exception was thrown (leaving any previous messages in
                                    the transaction if adapatively batched unacknowledged and uncommitted).
                                </li>
                                <li>
                                    Schedules an engine stop to be triggered after in-flight transactions have completed (excluding
                                    those in the current adaptive batch). Completion of prior transactions:
                                    <ul>
                                        <li>allows messages in prior transactions to be acknowledged upstream.</li>
                                        <li>because the engine is stopped with an exception, channel joins are preserved</li>
                                        <li>and a backup, if running, will take over.</li>
                                        <li>the backup will reprocess any of the unacknowledged messages.</li>
                                    </ul>
                                </li>
                            </ol>
                            If the engine cannot complete prior transactions due to a subsequent error the engine is still
                            stopped with an exception and a backup will reprocess messages from incomplete transactions as
                            well.
                            <br />
                            <br />
                            Note that even if all prior transactions complete successfully is currently possible that that
                            not all stabilized transactions will be reported to a backup or the transaction log. In such cases,
                            it is possible that outbound message redelivery can occur on failover or recovery, though those
                            messages will be filtered by Aep Duplicate Checking machinery at the downstream receiver if enabled. 
                            In this regard a RollbackAndStop failure in which an application isn't using duplicate checking has 
                            the same redelivery guarantees for outbound messaging as a process failure except that inbound messages 
                            are acknowledged upstream on a best effort basis. This doesn't impose any additional coding requirements
                            on application not using duplicate checking as they must tolerate duplicates to protect against process 
                            failure anyway.
                            <br />
                            <i>This is the default policy.</i>
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ReplicationPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates a service's cluster replications policies.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Asynchronous">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            With this replication policy, transactions (containing messages and/or state changes) are replicated without 
                            soliciting acknowledgements from the backup cluster instances. Therefore, inbound messages contained in these
                            transactions are acknowledged upstream without waiting for replication acknowledgement from the backup cluster 
                            instance(s).
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Pipelined">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            With this replication policy, transactions (containing messages and/or state changes) are replicated soliciting
                            acknowledgements from the backup engine cluster instance(s) but inbound message processing is not blocked waiting 
                            for the acknowledgement to be received. Inbound messages are processed in a pipelined manner in parallel with the 
                            replication traffic. However, inbound messages contained in replicated transactions are not acknowledged up stream 
                            until transaction replication acknowledgement are received from the backup instance(s).
                            <br />
                            <i>This is the default policy.</i>
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MessageSendExceptionHandlingPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that determine how the service engine to handles unchecked exceptions received on outbound message sends.
                    <br/>
                    Note: There are two types of send failures that the service engine can encounter during its operation.
                    <ul>
                        <li>
                            The first are exceptions thrown during the message send operation. Such exceptions are typically thrown by the underlying message bus connections.
                        </li>
                        <li>
                            The other, applicable only to guaranteed channels, is where the message send operation succeeds but could not be stabilized by the downstream
                        </li>
                    </ul>
                    This policy only applies to the former type of send failures. See MessageSendStabilityFailureHandlingPolicy for policies related to handling the latter type of failures
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="LogExceptionAndContinue">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Log an exception and continue operating.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="TreatAsStabilityFailure">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Treat the failure as a stability failure.
                            <br />
                            With this policy, the message send failure is treated the same as a message send stability failure.
                            <br />
                            This is the default policy.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MessageSendStabilityFailureHandlingPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that determines how the service engine handles message send stability failures
                    <br />
                    Note: There are two types of send failures that the service engine can encounter during its operation.
                    <ul>
                        <li>
                            The first are exceptions thrown during the message send operation. Such exceptions are typically thrown by the underlying message bus connections.
                        </li>
                        <li>
                            The other, applicable only to guaranteed channels, is where the message send operation succeeds but could not be stabilized by the downstream
                        </li>
                    </ul>
                    This policy only applies to the latter type of send failures. See MessageSendExceptionHandlingPolicy for policies related to handling the former type of failures
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="LogExceptionAndContinue">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Log an exception and continue operating.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="StopEngine">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Stop the service engine. 
                            <br />
                            With this policy, the service engine shuts down when it receives a stability failure notification
                            <br />
                            This is the default policy.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="QueueOfferStrategy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Specifies the strategy used by a thread to enqueue an event into an inter-thread queue.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="SingleThreaded">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Strategy used when there is only a single thread feeding the queue.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="MultiThreaded">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Strategy used when multiple threads can concurrently feed the queue
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="MultiThreadedSufficientCores">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Strategy used when there are multiple threads feeding the queue and there are enough cores to allow these threads to operate
                            concurrently when feeding the queue.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="QueueWaitStrategy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Specifies the strategy used by thread draining an inter-thread queue.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Blocking">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This strategy is the slowest of the available wait strategies, but is the most conservative with the respect to CPU usage and will 
                            give the most consistent behaviour across the widest variety of deployment options.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Sleeping">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Like the BlockingWaitStrategy this strategy it attempts to conserve CPU usage by using a simple busy wait loop, but uses a call to
                            LockSupport.parkNanos(1) in the middle of the loop. On a typical Linux system this will pause the thread for around 60us. However it 
                            has the benefit that the feeder thread does not need to take any action other that increment a counter and does not require the cost of
                            signaling a condition variable. However, the mean latency of moving the event between the queue feeder and drainer threads will be higher. 
                            It works best in situations where low latency is not required, but a low impact on the feeder thread is desired.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Yielding">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This strategy is one of two wait strategies that can be use in systems that need low latency, where there is the option to burn CPU cycles 
                            with the goal of improving latency. This strategy will busy spin waiting for events to appear in the queue. However, inside the body of
                            the loop, Thread.yield() is called allowing other queued threads in the system to run. This is the recommended wait strategy when need very 
                            high performance and the number of drainer threads is less than the total number of logical cores, e.g. you have hyper-threading enabled
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="BusySpin">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            This is the highest performing wait srategy, but puts the highest constraints on the deployment environment. This wait strategy should only
                            be used if the number of queue drainer threads is smaller than the number of physical cores on the host server
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PersisterLogScavengePolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the policies that determine how the store scavenges compacted transaction logs.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Delete">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that compacted transaction log files should be deleted.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Disabled">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that obsolete transaction log files should not be deleted. This policy is not usually recommended since it will result
                            in continuous growth of disk usage, but may be useful in special cases or for diagnostic reasons.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ICRRole">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the different inter-cluster replication roles of a service store.
                    <br />
                    In inter-cluster replication, the store contents of a cluster are replicated to one or more receiving clusters. This enumeration enumerates the 
                    different replication roles that can be assigned to clusters. Assigning a replication role to a cluster is tantamount to assigning the same 
                    inter-cluster replication role to all members of the cluster.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Sender">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Cluster members designated with this role serve serve as ICR senders.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="StandaloneReceiver">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Cluster members designated with this role serve as standalone ICR receivers. Standalone implies that the receive side members designated
                            with this role do not form clusters while operating in this mode. From the perspective of the user, the member operates as a backup cluster 
                            member but there is no intra-cluster replication actually occurring. There can be multiple simultaneous standalone ICR receivers.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="StoreBindingRoleExpectation">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates possible expectations regarding the role of a clustered store member.
                    <br />
                    This enumeration is used to indicate expectations regarding the role that a clustered store member assumes on startup.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="None">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that there is no expectation regarding the role a clustered store member assumes.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Primary">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that the clustered store member is expected to assume the role of Primary on startup.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Backup">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that the clustered store member is expected to assume the role of Backup on startup.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="LogEmptinessExpectation">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates possible expectations regarding the emptiness of a transaction log.
                    <br />
                    This enumeration is used to indicate expectations regarding the emptiness state of a transaction log on startup.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="None">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that there is no expectation regarding the emtiness of a transaction log
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Empty">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that a transaction log is expected to be empty
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="NotEmpty">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that a transaction log is expected to be non-empty
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="CheckpointingType">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the types of checkpointing controllers.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Default">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that the default checkpoint controller should be used.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="CDC">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that the CDC Checkpoint controller should be used.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Conflation">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates that the Conflation Checkpoint controller should be used.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:group name="EventMultiplexerProperties">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Defines configuration properties for an event multipler.
                    <br />
                    An event multiplexer is an inter-thread queue thatv multiplexes events arriving on the event sources' execution lines (threads) 
                    onto a single dispatch execution line (thread).
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="queueDepth" type="xs:positiveInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            The size of the multiplexer queue. This value should be a power of 2. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="queueOfferStrategy" type="QueueOfferStrategy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Controls the offer strategy for threads feeding events to the queue.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="queueWaitStrategy" type="QueueWaitStrategy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Controls the claim stategy for the thread draining events from the queue.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="queueDrainerCpuAffinityMask" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Sets the CPU affinity mask to use for the drainer thread.
                            <br />
                            The affinity string can either be a long that represents a mask of logical cpu or a square bracket enclosed comma separated 
                            list enumerating the logical cpus.
                            <br />
                            For example specifying "1" or "[0]" indicate Core 0. "3" or "[0, 1]" would indicate Core 0 or  Core 1. Specifying a value of 
                            "0" indicates that the the thread should be affinitized to the platform's default cpu, and omitting this value indicates that 
                            the queue drainer thread should be affinitized according to the platform's default policy for the multiplexer.
                            <br />
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="queueFeedMaxConcurrency" type="xs:positiveInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Sets the maximum number of threads that will feed the multiplexer's queue.
                            <br />
                            Note: If this value is set too low it will result in a runtime time error. Typically, applications need not specify this value.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:group>

    <xs:simpleType name="ChannelAndBusName">
        <xs:restriction base="xs:string">
            <xs:pattern value="(.)+@(.)+"></xs:pattern>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="JsonPrettyPrintStyle">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the different styles in which Json output can be printed.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Default">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies the default style of Json printing. The default style is PrettyPrint
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="PrettyPrint">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies that Json output should be pretty printed i.e. printed in multi-line, indented format.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Minimal">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies that Json output should be minimally printed on a single line.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="SingleLine">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies that Json output should be pretty printed but on a single line.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MessageMetadataDisplayPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates options for displaying message metadata
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="On">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies that metadata should be displated along with the message payload.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Off">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies that only the message payload should be displayed.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Only">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies that only the metadata should be displayed.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PreserveJoinPolicy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Configures preferences for preserving a channel's subscriptions or interests when a bus is closed cleanly.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="Default">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Use the bus' configured or default behavior to determine whether to remove a channel's subscriptions.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Leave">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Remove a channels subscriptions on close.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Preserve">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Don't remove a message channel's subscriptions on close.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="OffheapBufferingLoadStrategy">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Enumerates the various loader strategies that can be used to load entries not retained by a log checkpoint reader during its conflation and sorting pass.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="PktReader">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Uses a packet log reader to load the log entries into the off heap buffer. This approach loads entries from the log as packet objects and then 
                            reserializes these packet objects to the off heap buffer
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="RandomAccessFile">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Uses a random access file reader load log entries into the off heap buffer. This approach reads the raw entry bytes from the log and copies the
                            bytes to the off heap buffer. Consequently, this approach performs better than PktReader 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="MemoryMappedRead">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Uses a memory mapper file reader to load log entries into the off heap buffer. This approach performs the best since entry bytes do not need to 
                            be copied to an intermediate buffer before copying to the off heap buffer. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
            <xs:enumeration value="Disabled">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Disables off heap buffering. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:enumeration>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="hierarchicalPropertySet">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Holds a collection of hierarchically '.' delimited properties in which each property level can be represented by use child nodes.
                    <p>
                    For example:
                    <pre>
                    &lt;foo.bar&gt;baz&lt;/foo.bar&gt;
                    </pre>
                    can also be represented as:
                    <pre>
                    &lt;foo&gt;
                      &lt;bar&gt;baz&lt;/bar&gt;
                    &lt;/foo&gt;
                    </pre>
                    When parsed the values should be treated as a set of properties.
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:any minOccurs="0" processContents="skip" maxOccurs="unbounded"></xs:any>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="serviceBus">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Configures an service's usage of a message bus, and registers it with the application's underlying engine. Each application in the deployment 
                    will create its own bus instance, and may configure channel interest in that bus differently depending on their participation in the message 
                    flow.
                ]]>
            </xs:documentation>
        </xs:annotation>

        <xs:all>
            <xs:element name="channels" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Configures the bus channels used by the application.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="channel" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>
                                    Configures channel usage for an app.
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:all minOccurs="0" maxOccurs="1">
                                    <xs:element name="filter" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Set the filter for the channel that this descriptor describes. 
                                                    <p>
                                                    A channel filter filters variable parts of a channel key to filter what is received over the channel. 
                                                    </p>;
                                                    <p>
                                                    Unless otherwise specified by a particular channel implementation, a channel filter takes the following form: 
                                                    <br></br>
                                                     var1=val1[|val2][;var2=val3]  
                                                    </p>
                                                    <p>
                                                    <ul>
                                                    For example: given a channel key of "ORDERS/${Region}/{Department}", one can specify a channel filter of 
                                                    "Region=NA|EMEA;Department=Clothing". This would join the channel on: 
                                                    <li>ORDERS/NA/Clothing</li>
                                                    <li>ORDERS/EMEA/Clothing</li>
                                                    </ul> 
                                                    </p>
                                                    <p>
                                                    <ul>
                                                    If a variable portion of the channel key is omitted in a filter, it will result in the subscription being joined 
                                                    in a wildcard fashion (assuming the underlying bus implementation supports wildcards). So given a channel key of 
                                                    "ORDERS/${Region}/${Department}" and a channel filter of "Region=NA|EMEA", it would result in the following subscriptions 
                                                    being issued during join: 
                                                    <li>ORDERS/NA/*</li>
                                                    <li>ORDERS/EMEA/*</li> 
                                                    </ul> 
                                                    </p>
                                                    <p>
                                                    <ul>
                                                    Finally, if the channel filter is set to null for the channel key in the example above, then the resulting subscription would be: 
                                                    <li>ORDERS/*/*</li> 
                                                    </ul> 
                                                    </p>
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="preserveJoinsOnClose" type="PreserveJoinPolicy" default="Default" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets whether or not to preserve subscriptions for this channel when the engine stops and closes the channel without an error.
                                                    <br/>
                                                    By default when an engine is stopped without an error bus channels that were 'joined' will be 'left' meaning that any subscriptions 
                                                    or interests created by the message bus will be unsubscribed or unregistered. Whether or not channels' interests are preserved can 
                                                    be configured for an application using the app's preserveChannelJoinsOnStop setting. This configuration property allows the application 
                                                    configured behavior to be overridden on a channel by channel basis. 
                                                    <br/>
                                                    Note that this property has no effect for the case where a service engine shuts down with an error (e.g. AepEngine.stop(Exception) 
                                                    with a non null cause. In this case channel joins are left in tact allowing a backup to take over.
                                                    <br/>
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                </xs:all>
                                <xs:attribute name="name" type="xs:string" use="required">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                The name of the channel
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="join" type="xs:boolean" use="required">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                An application that should receive message on the channel should specify true.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="detachedSend" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Configures whether or not message sends are done by the service business logic thread or passed off to a bus connection thread.
                            <br/>
                            Offloading the send to the bus manager thread can free the application thread, but may incur slighly higher latency.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:group ref="EventMultiplexerProperties">
                        <xs:annotation>
                            <xs:documentation>
                                <![CDATA[
                                    Configures inter-thread queue properties for the detached sender thread when detachedSend is enabled.
                                ]]>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:group>
                    <xs:attribute name="enabled" type="xs:boolean" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <![CDATA[
                                    Specifies whether or not detached send is enabled for this bus.
                                ]]>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>

            <xs:element name="manualStart" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies whether this bus connection should be automatically started by the service engine or not. If specified as true, then the service engine will open
                            the bus connection when the engine starts messaging but will not start the connection. For such connections, the connection must be started by the service 
                            programatically
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="scheduleInboundMessageEvents" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates whether the inbound message events for this bus should be scheduled.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="nonBlockingInboundMessageDispatch" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies whether or not enqueue of inbound messages for this bus should block on the application's main inbound event multiplexer.
                            <br />
                            In most cases this value should either not be specified or set to false.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="inboundMessageEventPriority" type="xs:integer" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies at what priority message from this bus should be dispatched to the service's inbound event multiplexer.
                            <br />
                            A negative value is interpreted as higher priority. A positive value will result in delayed processing by the number of milliseconds specified. If not set 
                            or 0 message will be dispatched at normal priority.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="scheduleSendCommitCompletionEvents" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates whether the bus connection send commit completion events should be scheduled instead of multiplexed.
                            <br />
                            Scheduling, instead of multiplexing (the default), of the completion events can cause reduced contention with message events.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="sendCommitCompletionEventPriority" type="xs:integer" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Indicates the priority at which send commit completion events are processed.
                            <br />
                            Setting this value higher than message events can reduce message processing latency in some cases.
                            <br />
                            A negative value is interpreted as higher priority. A positive value will result in delayed processing by the number of milliseconds specified. If not set or 
                            set to 0, message will be dispatched at normal priority.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>

        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        Specifies whether or not this bus is enabled for the service.
                        <br />
                        If the bus is not enabled it will not be added to the engine.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        Specifies the name of the bus which should reference a bus from the buses section of this descriptor or one programatically created and saved in the 
                        service's configuration repository.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="busProvider">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                Defines a custom message bus binding provider.
                <p>
                A bus provider implements com.neeve.sma.MessagingProvider and is used to create message bus bindings. Bus providers are registered with the Rumi runtime to 
                facilitate custom bus binding implementations. 
                ]]>
            </xs:documentation>
        </xs:annotation>

        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        Can be used to disable the bus provider. A disabled bus will not be registered in the system.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="name" type="providerName" use="required">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        The bus provider name is the provider name used when configuring a bus of this type. For example a bus provider registered as 'foo' would be used for a 
                        bus configured with 'foo://address:port'
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="displayName" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        The friendly name for the message bus provider.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="providerClass" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        The provider class instance used to create message bus binding instances for this bus type. Refer to the Rumi documentation for information on how to
                        author custom messaging bus providers 
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="busConfig">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Defines and configures a messaging bus.
                ]]>
            </xs:documentation>
        </xs:annotation>

        <xs:all>
            <xs:element name="provider" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            The messaging bus provider name which can be specified along with address, port and properties instead of specifying the descriptor attribute. It is 
                            not permitted to specify both the provider element and the descriptor attribute in a bus definition. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="address" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            The bus address name which can be specified along with provider, port and properties instead of specifying the descriptor attribute. It is not permitted 
                            to specify both the address element and the descriptor attribute in a bus definition.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="port" type="xs:unsignedShort" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            The bus address name which can be specified along with provider, address and properties instead of specifying the descriptor attribute. It is not permitted 
                            to specify both the port element and the descriptor attribute in a bus definition.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="properties" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            List the bus descriptor parameters in key=value pairs e.g.
                            <p>
                             &lt;properties&gt;<br>
                             &nbsp;&nbsp;&lt;username&gt;jane&lt;/username&gt;<br>
                             &nbsp;&nbsp;&lt;single_session&gt;true&lt;/single_session&gt;<br>
                             &lt;/properties&gt;<br>
                             When specified along with the descriptor attribute, properties are appended to the descriptor.
                            </p>
                         ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="hierarchicalPropertySet"></xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="channels" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            List the channels for this bus.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="channel" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Defines and configures a channel within a message bus.
                                        <br />
                                        A message channel is a named conduit for message exchange between Rumi messaging participants. 
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>

                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="qos" type="ChannelQos" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    The channel QoS.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="key" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    The channel key.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                </xs:all>

                                <xs:attribute name="name" type="xs:string" use="required">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                The channel name.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>

                                <xs:attribute name="id" type="xs:short" use="optional">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                The channel id.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:all>

        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        Can be used to disable the bus. A disabled bus will not be added to applications.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        The name for the message bus.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="displayName" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        The friendly name for the message bus.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>

        <xs:attribute name="descriptor" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
                        The bus connection descriptor describes how to connect to the message bus
                        <p><br>
                        A bus descriptor must be specified, but it may alternatively be specified in a decomposed manner using the provider, address, port and properties elements 
                        instead of this descriptor element. The provider, address and port elements can not be used if the descriptor attribute is set. If the properties element 
                        is set along with the descriptor element the properties will be appended to the end of the descriptor.
                    ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="serviceConfig">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
                    Configures a Rumi service
                ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="messaging" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Configures messaging for the service.
                        ]]>
                    </xs:documentation>
                </xs:annotation>

                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="factories" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Configures the set of message factories used by the service
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>

                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="factory" minOccurs="0" maxOccurs="unbounded">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures a message factory used by the service
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                            <xs:attribute name="name" type="xs:string" use="required">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        <![CDATA[
                                                            The name of the message factory
                                                        ]]>
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>

                        <xs:element name="buses" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Lists and configures connections to buses used by this service.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>

                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="bus" type="serviceBus" minOccurs="0" maxOccurs="unbounded"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>

                        <xs:element name="bus" type="serviceBus" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Deprecated. Buses should be defined under the &lt;buses&gt; element.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="storage" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Configures the service store.
                        ]]>
                    </xs:documentation>
                </xs:annotation>

                <xs:complexType>
                    <xs:all>
                        <xs:element name="factories" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Configures the set of state factories used by the service
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="factory" minOccurs="0" maxOccurs="unbounded">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures a state factory used by the service
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                            <xs:attribute name="name" type="xs:string" use="required">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        <![CDATA[
                                                            The name of the state factory
                                                        ]]>
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>

                        <xs:element name="persistenceQuorum" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Set's a service store's persistence quorum.
                                        <br />
                                        The persistence quorum is the minimum number of service instances running in a service cluster that determines whether the store persists store 
                                        commits (i.e, changes to store contents) synchronously to disk or not. Synchronous persistence means that store commits are synchronously pushed 
                                        to the disk device for to be considered complete as opposed to being pushed to operating system buffers or held in user space buffers. If the 
                                        number of instances is greater or equal to the quorum, then store commits are persisted asynchronously (i.e, pushed to OS buffers) unless explicitly 
                                        configured to be synchronous. Otherwise, they are persisted synchronously.
                                        <br />
                                        The default persistence quorum is 2.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="maxPersistSyncBacklog" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Set's a store's max persist sync backlog.
                                        <br />
                                        When set to a value greater than 0 (in seconds), this will cause the store to perdiodically ensure that all buffered commits (in user space
                                        or OS buffers) are synced to disk. Setting this parameter to a non-zero value limits the amount of unsynced data (in time) held is user space
                                        or OS buffers. This is useful for low throughput services that are operating above their persistence quorum.
                                        <br />
                                        The default value of this parameter is 0 i.e. periodic sync is disabled.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="icrQuorum" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Set's a store's ICR quorum.
                                        <br />
                                        A store's ICR quorum is the minimum number of store instances in a service cluster that determines whether ICR sends performed as part of store 
                                        commits is executed synchronously or not. A synchronous send is executed by blocking and waiting for the send acknowledgement to be received from 
                                        downstream. Conversely, in an asynchronous, the ICR send operation does not synchronously wait for an acknowledgement. In such a situation, the
                                        ICR sender performs the send and then returns for the store commmit to continue. The acknowledgement is received and processed asychronous to the 
                                        execution of the store commit. If the number of instances is greater or equal to the quorum, then commits are sent by the ICR asynchronously. 
                                        Otherwise, they are performed ssynchronously.
                                        <br />
                                        The default ICR quorum is 2.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="maxIcrSyncBacklog" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Set's a store's max ICR sync backlog.
                                        <br />
                                        When set to a value greater than 0 (in seconds), this will cause the store to perdiodically ensure that all buffered commits (in user space
                                        or in transit to downstream components) are 'syncd' to the downstream component responsible for stabilizing and acknowledging the commit. 
                                        Setting this parameter to a non-zero value limits the amount of unsynced data (in time) held is user space or in network transit. This is 
                                        useful for low throughput services that are operating above their ICR quorum.
                                        <br />
                                        The default value of this parameter is 0 i.e. periodic sync is disabled.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="checkpointingType" type="CheckpointingType" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Sets the store's checkpoint controller type. A checkpoint controller determines the checkpoint boundaries within a transaction log by incrementing the checkpoint version for log entries. The checkpoint version is used by CDC and Log Compaction algorithms as the boundaries upon which those operations occur.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="checkpointThreshold" type="xs:integer" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Sets the store's checkpoint threshold. The threshold controls the maximum number of entries before a transaction log's checkpoint version is increased, a checkpoint controller keeps track of the number of entries that count towards reaching this threshold.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="checkpointMaxInterval" type="xs:integer" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Sets the max time interval (in millis) that can occur before triggering a new checkpoint.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="detachedMemberInitialization" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Sets whether backup member initialization is performed in a detached manner or not. When member initialization is set to detached, then the 
                                        member initialization executes concurrently with the message processing and store operation. Detached member initialization is another name 
                                        for non-blocking cluster join.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="detachedMemberInitializerCpuAffinityMask" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Sets the CPU affinity mask to use for the detached member initializer thread.
                                        <br />
                                        The affinity string can either be a long that represents a mask of logical cpu or a square bracket enclosed comma separated list enumerating 
                                        the logical cpus. For example specifying "1" or "[0]" indicate Core 0. "3" or "[0, 1]" would indicate Core 0 or Core 1. Specifying a value of 
                                        "0" indicates that the thread should be affinitized to the platform's default cpu, and omitting this value indicates that the thread should be 
                                        affinitized according to the platform's default policy.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="queryable" type="xs:boolean" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Indicates whether a store's in-memory contents are queryable using Rumi's SQL query language
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="captureLatencyStats" type="xs:boolean" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Indicates whether a store records latency stats as part of its operation
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="discoveryDescriptor" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        This field has been deprecated. Please use the <i>clustering</i> element instead.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="clustering" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Configured store clustering
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>

                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="storeName" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the name of the store. services with the same store name automatically form a cluster. If this configuration parameter 
                                                    is not specified, then the service name is used as the store name
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="localIfAddr" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the local network interface to bind to when establishing cluster network connections.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="localPort" type="xs:integer" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the TCP port to bind to when listening for cluster connections
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="linkParams" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    A comma separate set of key=value pairs that serve as additional configuration parameters for the network connections between the 
                                                    cluster members
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="linkReaderCpuAffinityMask" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the CPU affinity mask to use for the cluster connection reader thread. The affinity string can either be a long that represents
                                                    a mask of logical cpu or a square bracket enclosed comma separated list enumerating the logical cpus. For example specifying "1" or 
                                                    "[0]" indicate Core 0. "3" or "[0, 1]" would indicate Core 0 or Core 1. Specifying a value of "0" indicates that the the thread should 
                                                    be affinitized to the platform's default cpu, and omitting this value indicates that the thread should be affinitized according to
                                                    the platform's default policy.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="discoveryDescriptor" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the custom discovery descriptor for the store.
                                                    <br />
                                                    When set, this descriptor is used to connect to the discovery network to discover other service instances (members) in the service 
                                                    cluster If this value is not set, then the store will use the configured default discovery descriptor.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="discovery" type="discoveryDescriptor" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Can be used instead of the discoveryDescriptor element to define the discovery network connection descriptor in a decomposed manner. 
                                                    This element cannot be used in conjuction with the discoveryDescriptor element i.e., one or the other must be specified. Using the 
                                                    using the <discovery> element is useful in conjuection with DDL profiles or templates as it allows for discovery connection parameters 
                                                    to be merged together in a more convenient fashion. 
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="initWaitTime" type="xs:integer" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the time, in milliseconds, that the store cluster manager will wait on open for the cluster to stabilize. When a store binding 
                                                    opens its store binding (its connection to the clustered store), it joins the discovery network to discover other cluster members.
                                                    Once discovered, the members need to connect to each other, perform handshakes and elect roles. This parameter governs how long, 
                                                    after the binding has joined the discovery network, does the cluster manager wait for the store cluster to "stabilize" i.e., find 
                                                    all thje cluster members that are already out there.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="failOnMultiplePrimaries" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Set whether a store cluster manager should fail the store on detecting multiple primaries in a cluster. 
                                                    <br />
                                                    The default policy is to fail on detecting multiple primaries. This means that, if multiple primaries are detected, the members 
                                                    elected as primaries and discovering other primaries out there will shut down to prevent a "split-brain" situation. However, if 
                                                    this parameter is set to true, then these members will continue to operate as primaries but will not establish connections with 
                                                    the other member that also detected as primaries i.e, the multiple primaries will continue to operate independently as primaries.  
                                                    <br/>
                                                    This parameter should only be used if the service or messaging layer possess a distributed locking mechanism that will cause one 
                                                    of the two dual primaries to not be able to open their messaging connection (because there is another primary that has acquired 
                                                    the lock) thus ultimately resulting in only one primary functioning in the cluster. Switching on this parameter without such a 
                                                    mechanism can have significant operational impact on the running of the service.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="memberElectionPriority" type="xs:unsignedByte" minOccurs="0" maxOccurs="1" default="255">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the leader election priority to determine which cluster member will assume the primary role when two members connect and 
                                                    neither has already assumed a role i.e, when two members are started simulatenously within the initWaitTime interval. The member 
                                                    with the lower election priority will be elected primary. The default value when not configured is 255. 
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="detachedSend" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures whether or not to send the outbound replication traffic by the servide engine business logic thread or pass off the 
                                                    send to a detached replicator sender thread. Offloading the send to a dedicated sender thread can increase store throughput but
                                                    at the cost an extra processor core for the sender thread and, normally, slightly higher latency (although latency can reduce in 
                                                    some complex flows in which the cost of performing a network write by the business logic thread can adversely impact service 
                                                    latency).
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>

                                        <xs:complexType>
                                            <xs:group ref="EventMultiplexerProperties"/>
                                            <xs:attribute name="enabled" type="xs:boolean" use="optional">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        <![CDATA[
                                                            Enables/disables detached send.
                                                        ]]>
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>

                                    <xs:element name="detachedDispatch" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures whether or not to dispatch the inbound replication traffic by the replication link reader thread itself or pass the
                                                    dispatch off to a detached replicator dispatcher thread. Offloading the dispatch to a dedicated dispatcher thread can increase 
                                                    store throughput but at the cost of an extra processor core for the dispatcher thread and. normally, slightly higher latency.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>

                                        <xs:complexType>
                                            <xs:group ref="EventMultiplexerProperties"/>
                                            <xs:attribute name="enabled" type="xs:boolean" use="optional">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        <![CDATA[
                                                            Enables/disables detached dispatch.
                                                        ]]>
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:all>

                                <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                Set this to false to disable store clustering.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>

                        <xs:element name="persistence" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Configured store persistence
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>

                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="shared" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Whether or not this is a shared persister.
                                                    <br/>
                                                    Note: This is an advanced property used when using storage shared by cluster members. Use of this property is only supported
                                                    with instructions and support from the N5 customer success team. 
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="flushOnCommit" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Whether or not the persister write buffer should be flushed on commit.
                                                    <br/>
                                                    By default a persister writes data into an internal buffer and then flushes the data from that buffer to the disk. If 
                                                    <i>flushOnCommit</i> is set to true, then the data is flushed from the buffer at the end of each commit. Otherwise,
                                                    the data is flushed when the buffer fills up or the periodic flusher is enabled.
                                                    <br/>
                                                    The use of an intermediate buffer for writes is disabled if system is optimized for latency and flush using memory mapped 
                                                    IO is enabled. It is enabled otherwise.
                                                    <br/>
                                                    The default value of this parameter is true.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="writeBufferSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[    
                                                    Specifies the size of the write buffer for buffered writes.
                                                    <br/>;
                                                    The default value of this parameter is 8192.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="autoFlushSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    This field has been deprecated. Please use the <i>writeBufferSize</i> element instead.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="autoRepair" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Specifies whether the persister will automatically attempt to repair logs that fail to open due to corruption. Transaction logs are
                                                    repaired by truncating log at the first corrupt entry found in the log.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="storeRoot" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Specifies the root folder in which the persister's transaction log files are located.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="cdcEnabled" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Whether CDC is enabled on the log.
                                                    <br/>
                                                    If CDC is not enabled, then a CDC processor run on a log will not dispatch any events. If CDC is not enabled on a log and then 
                                                    reenabled later, CDC will start from the live log at the time the CDC is enabled. If a compaction occurred while CDC was disabled,
                                                    then the change events that occurred during that time will be lost.
                                                    <br/>
                                                    The default value of this parameter is "false"
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="logScavengePolicy" type="PersisterLogScavengePolicy" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets policy used to scavenge logs
                                                    <br />
                                                    A log with number N is considered a candidate for scavenging when N is less than the live log number and N less than the 
                                                    CDC log number i.e. when a log has been compacted _and_ CDC has completed its run over the log . This parameter specifies 
                                                    how such logs need to be scavenged. Currently, the only permissible value is 'Delete'
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="logBackupRetentionCount" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Specifies the maximum retention count for log backups that are made automatically during certain store operations
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="initialLogLength" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the initial file size, in gigabytes, of persister's transaction log
                                                    <br />
                                                    Preallocating the transaction log can save costs in growing the file size over time. Preallocation with initialization
                                                    i.e., zeroOutInitial=true can result in lower and more predictable latency.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="zeroOutInitial" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Whether the log file should be explictly zeroed out (to force commit all disk pages) if newly created.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="flushUsingMappedMemory" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Whether flushes to the log file should be performed using a memory mapped IO
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="readBufferSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[    
                                                    Specifies the size of the read buffer for buffered reads i.e., non-memory mapped reads
                                                    <br/>
                                                    The default value of this parameter is 8192
                                                    </p>
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="pageSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Sets the disk page size.
                                                    <br />
                                                    The persister log will use this as a hint in many areas to optimize its operation.
                                                    <br/>
                                                    When no unit suffix is specified this value is interpreted in bytes. 
                                                    </p>
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="compaction" type="compactionConfig" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures properties for log compaction.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="cdc" type="cdcConfig" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures CDC (Change Rata Capture) for the persister transaction log.
                                                    <br/>
                                                    Change data capture allows a handler to be registered that will receive changes made to a persister's transaction log. CDC can be
                                                    configured to operate in "raw" mode i.e, essentially tail the transaction log or in a "transaction" mode in which case the CDC
                                                    processor conflates entries in the log and dispatches state changes to the CDC listener. The latter mode only applies to State
                                                    Replicaton services. If CDC is run on an Event Sourced service in "transaction" mode, then the CDC listener will receive nothing.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="detachedPersist" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures whether or not store commits are written by the service engine business logic thread or passed off to a detached persister 
                                                    write thread. Offloading the write to a dedicated persister thread can increase store throughput but at the cost of an extra processor 
                                                    core for the persister thread and slightly higher latency (although latency can reduce in some complex flows in which the cost of 
                                                    performing a disk write by the business logic thread can adversely impact the measured service latency).
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>

                                        <xs:complexType>
                                            <xs:group ref="EventMultiplexerProperties"/>
                                            <xs:attribute name="enabled" type="xs:boolean" use="optional">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        <![CDATA[
                                                            Configures inter-thread queue properties for the detached persister thread when detachedPersist is enabled.
                                                        ]]>
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:all>

                                <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                Can be set to false to disable disk based persistence.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>

                                <xs:attribute name="class" type="xs:string" use="optional" default="native">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                Can be set to a custom implemenation of a store persister class.
                                                <br />
                                                If omitted or "native" is specified the platform's default persister will be used.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>

                        <xs:element name="icr" minOccurs="0" maxOccurs="1">
                            <xs:complexType>
                                <xs:all minOccurs="0" maxOccurs="1">
                                    <xs:element name="shared" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Whether or not an ICR Sender is a shared sender.
                                                    <br />
                                                    Note: This property is for internal use. Its values should *neve* be changed.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="flushOnCommit" type="xs:boolean" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Whether or not the icr sender should be flushed on commit.
                                                    <br />
                                                    The ICR sender may buffer data before it sends it to the messaging bus. If <i>flushOnCommit</i> is set to true, then the data 
                                                    is flushed from the buffer i.e. sent downstream on the ICR bus at the end of each commit. Otherwise, the data is flushed 
                                                    when the buffer fills up or the periodic flusher is enabled.
                                                    <br/>
                                                    The use of an intermediate buffer for writes is disabled if system is optimized for latency. It is enabled otherwise.
                                                    <br/>
                                                    The default value of this parameter is true.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>

                                    <xs:element name="detachedSend" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Configures whether or not store commits are sent on the ICR bus by the service engine business logic thread or passed off to 
                                                    a detached sender thread. Offloading the write to a dedicated sender thread can increase store throughput but at the cost of 
                                                    an extra processor core for the sender thread and slightly higher latency (although latency can reduce in some complex flows 
                                                    in which the cost of performing a message publish by the business logic thread can adversely impact the measured service latency).
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>

                                        <xs:complexType>
                                            <xs:group ref="EventMultiplexerProperties"/>
                                            <xs:attribute name="enabled" type="xs:boolean" use="optional">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        <![CDATA[
                                                            Configures inter-thread queue properties for the detached sender thread when detachedSend is enabled.
                                                        ]]>
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>

                                    <xs:element name="bus" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                                                    Defines and configures the bus used for ICR.
                                                    <br/>
                                                    The ICR bus can be configured by either the bus element or the bus descriptor attribute. It is illegal to use both mechanism.
                                                ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                            <xs:all minOccurs="0" maxOccurs="1">
                                                <xs:element name="provider" type="xs:string" minOccurs="1" maxOccurs="1">
                                                    <xs:annotation>
                                                        <xs:documentation>
                                                            <![CDATA[
                                                                The bus provider name.
                                                            ]]>
                                                        </xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>

                                                <xs:element name="address" type="xs:string" minOccurs="1" maxOccurs="1">
                                                    <xs:annotation>
                                                        <xs:documentation>
                                                            <![CDATA[
                                                                The bus address.
                                                            ]]>
                                                        </xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>

                                                <xs:element name="port" type="xs:unsignedShort" minOccurs="0" maxOccurs="1">
                                                    <xs:annotation>
                                                        <xs:documentation>
                                                            <![CDATA[
                                                                The bus port for bus providers that accept a port.
                                                            ]]>
                                                        </xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>

                                                <xs:element name="properties" minOccurs="0" maxOccurs="1">
                                                    <xs:annotation>
                                                        <xs:documentation>
                                                            <![CDATA[
                                                                List the bus descriptor parameters in key=value pairs e.g.<br><br>
                                                                &lt;properties&gt;<br>
                                                                &nbsp;&nbsp;&lt;username&gt;jane&lt;/username&gt;<br>
                                                                &nbsp;&nbsp; &lt;single_session&gt;true&lt;/single_session&gt;<br>
                                                                &lt;/properties&gt;
                                                            ]]>
                                                        </xs:documentation>
                                                    </xs:annotation>

                                                    <xs:complexType>
                                                        <xs:complexContent>
                                                            <xs:extension base="hierarchicalPropertySet">
                                                            </xs:extension>
                                                        </xs:complexContent>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:all>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:all>

                                <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                Can be set to false to disable inter cluster replication.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="role" type="ICRRole" use="required">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                Configures the ICR role for this service instance
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>

                                <xs:attribute name="busDescriptor" type="xs:string" use="optional">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                Configures the bus descriptor to use for ICR. ICR uses this to establish its connection to the ICR bus. 
                                                <br/>
                                                A bus descriptor must be specified, but it may alternatively be defined using the bus element. Both the bus element and the 
                                                busDescriptor may not be used at the same time.
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>

                    <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                        <xs:annotation>
                            <xs:documentation>
                                <![CDATA[
                                    Can be set to false to disable the store for this service.
                                ]]>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="descriptor" type="xs:string" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <![CDATA[
                                    This attribute has been deprecated. Use the clustering element instead.
                                ]]>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>

            <xs:element name="inboundEventMultiplexing" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Configures the service engine's inbound event multiplexer queue.
                        ]]>
                    </xs:documentation>
                </xs:annotation>

                <xs:complexType>
                    <xs:group ref="EventMultiplexerProperties"/>
                    <xs:attribute name="type" type="InboundEventMultiplexerType" use="optional">
                        <xs:annotation>
                            <xs:documentation>
                                <![CDATA[
                                    The type of inbound event multiplexer to use for an app.
                                ]]>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>

            <xs:element name="inboundMessageLogging" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Configures the service's inbound message logging. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>

                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="messageLogger">
                            <xs:attribute name="policy" type="InboundMessageLoggingPolicy" use="required">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            The inbound message logging policy.
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>

                            <xs:attribute name="failurePolicy" type="InboundMessageLoggingFailurePolicy" default="StopEngine">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            The inbound message logging failure policy.
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="outboundMessageLogging" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Configures the service's oubtbound message logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>

                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="messageLogger">
                            <xs:attribute name="policy" type="OutboundMessageLoggingPolicy" use="required">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            The outbound message logging policy.
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>

                            <xs:attribute name="failurePolicy" type="OutboundMessageLoggingFailurePolicy" default="StopEngine">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            The outbound message logging failure policy.
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="perTransactionStatsLogging" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Configures the service's per transaction stats binary logging.
                        ]]>
                    </xs:documentation>
                </xs:annotation>

                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="messageLogger">
                            <xs:attribute name="policy" type="PerTransactionStatsLoggingPolicy" use="required">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            The per transaction stats logging policy.
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>

                            <xs:attribute name="failurePolicy" type="PerTransactionStatsLoggingFailurePolicy" default="StopEngine">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            The per transaction stats logging failure policy.
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="startupExpectations" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies expectations that must be met on service startup.
                        ]]>
                    </xs:documentation>
                </xs:annotation>

                <xs:complexType>
                    <xs:all>
                        <xs:element name="role" type="StoreBindingRoleExpectation" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Specifies cluster role of a service instance on startup.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="logEmptiness" type="LogEmptinessExpectation" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                                        Specifies log emptiness expectations of a service instance at startup.
                                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>

            <xs:element name="inboundEventAcknowledgementPolicy" type="InboundEventAcknowledgementPolicy" minOccurs="0" maxOccurs="1" default="Default">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies the policy controlling when inbound events processed by a service are acknowledged upstream. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="appExceptionHandlingPolicy" type="MessageHandlerExceptionHandlingPolicy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies policy used by the service engine for handling unchecked exceptions thrown by a service message handler. When not set, the exception policy will default 
                            to the engine's default handler exception handling policy. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="replicationPolicy" type="ReplicationPolicy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies the service's replication policy.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="messageSendExceptionHandlingPolicy" type="MessageSendExceptionHandlingPolicy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies the policy that determines how the service engine handlers unchecked exceptions thrown by a outbound message send operation.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="messageSendStabilityFailureHandlingPolicy" type="MessageSendStabilityFailureHandlingPolicy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies the policy that determines how the service engine handlers stability failures reported by downstream messaging recipients of outbound message sends.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="messagingStartFailPolicy" type="MessagingStartFailPolicy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies the policy that determines what action a service engine takes when it fails to start one or more of the serrvice's messaging bus connections.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="messageBusBindingFailPolicy" type="MessageBusBindingFailPolicy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies the policiy that determines what action a service engine takes when a service's message bus connection fails.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="adaptiveCommitBatchCeiling" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Set the service's adaptive commit batch ceiling.
                            <br />
                            The adaptive commit batch ceiling controls the maximum number of inbound messages to group into a single transaction commit. Such a batching typically
                            significantly increases throughput.
                            <br />
                            A value less than or equal to 1 disables adaptive commit.
                            <br />
                            Adaptive commit cannot be combined if transaction commit suspension is enabled.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="enableReplayOnRollback" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            When a transaction is rolled back by the service, the service code can specify whether the rollback also rolls back the current input message pointer. A 
                            request to roll back the current input message pointer (to the beginning on the transaction or to the last savepoint) means that the rolled back messages 
                            will be replayed from the next message onwards. This parameter governs whether that functionality is enabled or not. The user should set this parameter to 
                            true if that functionality is desired. Otherwise, the engine will throw an exception if that request is made and this parameter is set to false. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="dispatchTransactionStageEvents" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies whether or not transaction state events are dispatched by the engine. Transaction state events are waypoint events dispatched as the service engine 
                            progresses through the transaction execution.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="enableTransactionCommitSuspension" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies whether transaction commit suspension is enabled or not.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="enableTransactionSavepoints" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies whether transaction savepoints are enabled or not.
                            <br/>
                            Enabling transaction savepoints introduces a small amount of latency overhead in the engine. It is only recommended that it be enabled for services 
                            that need it. If not enabled, calls to the service engine (AepEngine) to create or rollback to savepoints will throw an IllegalStateException. 
                            Therefore, this setting must be enabled before the engine's savepoint API can be used. 
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="replicateSolicitedSends" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Set whether to replicate (and persist) transactional (solicited) sends.
                            <br />
                            This parameter determines whether transactional (solicited) sends (sends triggered by the processing of inbound messages) performed by a State Replication 
                            service are to be included in the commit of the transaction in which the sends were performed. For State Replication to operate correctly i.e, ensure zero
                            loss failover and/or restart of the service, messages sent by message handlers need to be included in the commit of its transaction. Not doing so (which is
                            what this parameter enables) will like result in loss of outbound messages on service failover and/or restart and, consequently, changing the default value
                            of this parameter should be done with extreme caution.
                            <br />
                            This parameter is only applicable to State Replication services. It has no effect on Event Sourced services.
                            <br />
                            The default value for this parameter is true.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="replicateUnsolicitedSends" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Set whether to replicate (and persist) non-transactional (unsolicited) sends.
                            <br />
                            This parameter determines whether non-transactional (unsolicited) sends (sends triggered outside of a message handler) are replicated or not.
                            <br/>
                            Note: This parameter only applies to services configured for clustering
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="sequenceUnsolicitedSends" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
                            Specifies whether to sequence non-transctional (unsolicited) sends.
                            <br />
                            By default, non-transactional sends are sent with a sequence number of 0. Enabling parameter will cause sequence numbers to be attached to non-transctional
                            sends too. 
                            <br />
                            The default value for this parameter is false.
                        ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="sequenceUnsolicitedWithSolicitedSends" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Set whether to sequence unsolicited sends with solicited sends.
            <br />
            This parameter is applicable for services performing concurrent
            solicited and
            unsolicited sends and want the unsolicited sends to be
            sequenced.
            Setting this parameter ensures that unsolicited and
            solicited
            sends are sequenced on the wire in the same order in which
            the sequence numbers were attached to the messages. In effect
            this
            causes an unsolicited send to be injected into the
            underlying
            engine's transactional event processing stream
            promoting it to a
            transaction event.
            <br />
            The default value for this parameter is false.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="dispatchSendStabilityEvents" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            <p>
            Set whether or not the engine dispatches AepSendStabilityEvent for unsolicited sends.
            </p>
            <p></br>
            When an service that sends messages through the engine from outside of a message handler (an unsolicited send)
            would like to receive notification when the the send has been stabilized, this setting can be 
            enabled to instruct the engine to dispatch an AepSendStabilityEvent when the engine can provide
            guarantees that the message will be delivered. This functionality is useful for gateway services that input messages
            into the system from an external source. 
            </p>
            <p></br>
            <b>Send Stability</b></br>
            <p>
            An AepEngine considers an unsolicited send to be stabilized in accordance with its InboundEventAcknowledgementPolicy
            when then message is included in the transaction stream, and when the message is acknowledged by the bus when sent outside of the 
            transaction stream:
            <ul>
              <li><b>Sent in the transactions stream:</b>  
                <ul>
                   <li><b>inboundEventAcknowledgementPolicy=OnSendStability</b> The send is considered to be
                   stabilized on receipt of acknowledgement for the all of the messages in the transaction in which the messages is 
                   sent including acknowledgement of all messages in prior transactions. In other words on transaction ordered send stability.
                   </li>
                   <li><b>inboundEventAcknowledgementPolicy=OnStoreStability:</b> The send is considered to be 
                   stabilized when the transaction has been replicated to a backup instance and/or the engine's transaction log. 
                   <i>Note that for messages sent with BestEffort Qos this means that the message may be considered
                   to have been stabilized prior to even attempting to send the message.</i> 
                   </li>
                </ul>
              </li>
              <li><b>Send outside of transaction steam (sequenceUnsolicitedWithSolicitedSends=false replicateSolicitedSends=false):</b>
              In this case the AepSendStabilityEvent is triggered on receipt of acknowledgement of the message from the bus over which it is sent. 
              </li>
            </ul>
            </p>
            <p></br>
            <b>HA Considerations</b></br>
            <ul>
            <li><b>EventSourcing:</b> For an engine operating in EventSourcing mode, unsolicited sends are not 
            replicated to backup instances or stored in the engine's transaction log. Consequently, using an inbound event acknowledgement policy
            of InboundEventAcknowledgementPolicy.OnStoreStability} would mean that the unsolicited sends would not be retried
            in the event of a failure even if stability was communicated back to the sender. 
            </li>
            <li><b>Dispatch of AepSendStabilityEvent after failure:</b> An engine that has assumed a primary ha role after failover or recovery will 
            not dispatch AepSendStabilityEvents for recovered sends.
            </li>
            <li><b>At Least Once Delivery:</b> It is important to note that <i>at this time</i> unsolicited sends are at least once in nature, not exactly once as there
            is not currently a mechanism for an unsolicited sender to determine the last message successfully stabilized by the engine prior to a failure.
            Consequently, downstream services must be prepared to handle duplicate transmissions for unsolicited sends. 
            </li>
            </ul>
            </p>
            <p></br>
            <b>Additional Considerations</b></br>
            <ul>
            <li><b>Threading:</b> AepSendStabilityEvents are emitted on the AepEngine's multiplexer thread. services that expect to do expensive 
            processing or potentially blocking processing (especially operations subject to network flow control) are advised to perform such logic in a 
            separate thread. 
            </li>
            <li><b>Send Stability Event Ordering:</b> When sequenceUnsolicitedWithSolicitedSends is true any thread sending unsolicited sends can be assured that stability events will be issued
            in the order that messages were sent. When sequenceUnsolicitedWithSolicitedSends=false then stability events will be dispatched in the order that acknowledgements come
            back from the bus/channel on which they were sent (which is usually ordered for sends on the same bus+channel+qos). 
            </li> 
            </ul>
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="disposeOnSend" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Set whether or not the engine disposes sent messages.
            <br />
            If set, then the AepEngine.sendMessage method will dispose a message
            after it has
            been sent. This means that the caller must not hold onto
            or reference a message beyond the call to the send message
            method.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="clusterHeartbeatInterval" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets the cluster heartbeat interval for the service (in
            milliseconds).
            <br />
            When replicating messages and state to its cluster peers, the
            AepEngine
            piggybacks internal state such as outbound message acknowledgements
            and other internal control data. Setting a cluster
            heartbeat interval
            can be useful for low throughput services to keep the backup in closer
            sync to the primary. The most common usecase for setting this would be to
            reduce the number of in doubt messages outstanding in backup peers.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="administrative" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Marks the service as an 'administrative' service.
            <br />
            Marking an service as 'administrative' excludes it from being
            included
            in latency or throughput optimizations that demand system resources.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="stuckAlertEventThreshold" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets the threshold, in seconds, after which an AepStuckAlertEvent is
            dispatched to
            the service's IAepAsynchronousEventHandler.
            <br />
            An AepStuckAlertEvent event is intended to alert that the engine's
            transaction pipeline
            is "stuck" i.e. there are one or more
            transaction commits in the pipeline and the event
            multiplexer thread is not processing any events. For example, the event multiplexer
            thread could be flow controlled on
            the replication TCP connection due to an issue in the
            backup or could be spinning in a loop in the business logic due to a bug in a business logic
            handler.
            <br />
            Setting this value to 0 (or omitting it), disables stuck alerts. 
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="performDuplicateChecking" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Set whether the service's engine should perform duplicate
            checking
            <br />
            When duplicate checking is enabled received messaegs that are deemed
            duplicates
            are discarded by the service's engine. A message is considered to be a duplicate
            under the following circumstances:
            <ul>
                <li> The message has a sequence number that is greater than 1.</li>
                <li> The sequence number is less than the last received sequence
                    number for
                    the flowId and senderId in the message.</li>
            </ul>
            A sequence number of 1 is interpreted as a restart of a messaging
            stream. A value
            of 0 or less means the message is not sequenced and
            will ignored for duplicate
            checks.
            <h2>Sequence id assignment by an {@link AepEngine}</h2>
            <ul>
                <li>
                    <b>MessageSender</b>
                    : Is assigned by the AepEngine using the hashcode of
                    the engine name.
                </li>
                <li>
                    <b>MessageFlow</b>
                    : Leaves flow unset as 0 (default). At present it is not
                    recommended for services to set a flow.
                </li>
                <li>
                    <b>MessageSequenceNumber</b>
                    : Set for each send from a event handler by
                    incrementing a sequence number or for each unsolicited send (outside of a event
                    handler) when sequenceUnsolicitedSends
                    is true.
                </li>
            </ul>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="performMidstreamInitializationValidation" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Set whether the engine checks that initial transactions are not
            missing during
            recovery or replication. This parameter is only applicable to event sourced
            engines.
            <br />
            <i>It is not recommended that you disable this check unless recommended
            by official Rumi Support.</i>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableSequenceNumberTrace" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enables diagnostic trace logging related to message
            sequencing. 
            <p><br>
            Enabling
            this trace can assist in diagnosing issues related to the loss, duplicate
            or out of order events. When enabled trace will be emitted at debug level
            (TRACE level for SLF4J) to the logger named 'nv.aep.sno'
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableEventTrace" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enables diagnostic trace logging of events received
            and dispatched by an engine. 
            <p><br>
            Enabling this trace is useful in determining the sequence of events
            processed by the engine. When enabled trace will be emitted at debug level
            (TRACE level for SLF4J) to the logger named 'nv.aep.event'.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableAlertTrace" type="xs:boolean" default="true" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enables diagnostic trace logging for IAlertEvents emitted by the AepEngine. 
            <p><br>
            Alert tracing is enabled by default, but may be disabled by services that
            provide their own handling for alert events. 
            </p>
            <p><br>
            When enabled, trace will be emitted at 'warning' level
            (or WARN level for SLF4J) to the logger named 'nv.aep.alert'.
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableTransactionTrace" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enables diagnostic trace logging related to
            transactions processed by an
            engine. 
            <p><br>
            Enabling this trace is useful in determining the relative sequencing
            and timing of transaction commits as the commits are executed by the engine.
            When enabled trace will be emitted
            at debug level (TRACE level for SLF4J) to
            the logger named 'nv.aep.txn'.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableScheduleTrace" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enable diagnostic trace logging related to schedules
            (timers) managed by an
            engine. 
            <p><br>
            Enabling this trace is useful for diagnosing issues related to engine
            timer execution and scheduling. When
            enabled trace will be emitted at debug level
            (TRACE level for SLF4J) to the logger named 'nv.aep.sched'.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableMessageTrace" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enables diagnostic trace logging for messages as they
            pass through the engine.
            <p><br>
            Enabling this trace is useful for
            tracing the contents of messages at
            different stages of execution
            within the engine. When enabled, trace will be
            emitted at debug level (TRACE level for SLF4J) to the logger named 'nv.aep.msg'.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="messageTraceInJson" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets whether messages are traced in Json or toString
            format. 
            <p><br>
            When enabled,
            messages will be printed in Json format, otherwise message will be traced
            using its toString method. This parameter is only applicable is message
            trace is enabled.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="messageTraceJsonStyle" type="JsonPrettyPrintStyle" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets the styling for Json formatted message trace.
            <p><br>
            This parameter is
            only applicable is message trace in Json is enabled.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="messageTraceMetadataDisplayPolicy" type="MessageMetadataDisplayPolicy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Sets whether metadata, payload or both will be traced when message tracing is enabled.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="messageTraceFilterUnsetFields" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Sets whether unset fields are filtered for json formatted objects when json message tracing is enabled.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="maxEnvironmentProviders" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Sets the maximum number of environment providers that can be registered with the engine.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableSendCommitCompleteSequenceAlerts" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Set whether or not to enable out of order send commit
            completion detection.
            <p><br>
            When enabled, the engine will check that
            stability events (acknowledgements)
            from the underlying messaging provider are received in an ordered fashion.
            If acknowledgements are received out of order, then the engine will dispatch
            appropriate alerts.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="captureMessageTypeStats" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets whether statistics are additionally recorded ona
            per message type basis.
            <p><br>
            Collection of message type specific
            statistics records counts and rates per
            type as well as message processing time statistics for each message which can
            be useful in finding particular handlers that have high execution times.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="messageTypeStatsLatenciesToCapture" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Property controlling which latency stats on a per message type basis.
            This property is specified as a comma separated list of values. 
            <p>
            Valid value include: 
            <ul>
              <li><b>all</b> -- <i>Indicates that all available per message type latency stats should be collected.</i></li> 
              <li><b>none</b> -- <i>Indicates that no message type latency stats should be collected.</i></li> 
              <li><b>c2o</b> -- <i>Indicates create to offer latencies should be captured.</i></li> 
              <li><b>o2p</b> -- <i>Indicates offer to poll (input queueing time) should be captured.</i></li> 
              <li><b>mfilt</b> -- <i>Indicates that time spent in service message filters should be captured.</i></li> 
              <li><b>mpproc</b> -- <i>Indicates that time spent in the engine prior to message dispatch should be captured.</i></li> 
              <li><b>mproc</b> -- <i>Indicates that the time spent in service message handlers should be captured.</i></li> 
            </ul>
            </p>
            <p>
            The values 'all' or 'none' may not be combined with other values.
            </p>
            <p>
            This value only applies when captureMessageTypeStats is true. 
            </p>  
            <p>
            When not specified the value defaults to all. 
            </p>  
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="captureTransactionLatencyStats" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Sets whether or not the engine records transaction latency stats.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="captureEventLatencyStats" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Sets whether or not the engine records event processing latency stats.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="capturePerTransactionStats" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets whether or not the engine record per transaction stats. 
            <p>
            Unlike captureTransactionLatencyStats which records histographical latencies,
            this setting is much more expensive in that it records and emits individual timestamps
            for operations that occured in the transaction including store commit timestamps and 
            individual message timestamps.  
            </p>
            <p>
            In most cases the capturing this level of detail is not worth the overhead it incurs, 
            as the histographical latency captured via captureTransactionLatencyStats is usually sufficient
            for inferring timings within a given sampling interval. However, in cases where it is critical
            to determine the exact timings of transaction processing to better understand product behavior
            it can be useful. 
            </p>
            <p>
            If used in production (which is not recommended), services should undergo stress testing
            under maximum peak load to determine the impact of enabling collection of per transaction stats. 
            </p>
            <p>
            <i> Per transaction stats collection is currently classified as an experimental feature. 
            It is subject to change without notice.
            </i>
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="replicateInParallel" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enables parallel replication. 
            <p><br>
            When parallel
            replication is enabled,
            the engine replicates inbound messages to the cluster backups in
            parallel with the processing of the message by the message handler.
            This parameter only applies to Event Sourced engines.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="preserveChannelJoinsOnStop" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets whether or not to preserve joined channels when the engine
            stops normally.
            <br />
            By default when an engine is stopped without an error bus channels
            that were 'joined'
            will be 'left' meaning that any subscriptions or interests created by the message bus
            will be unsubscribed or unregistered. Setting this value to true causes the engine to
            preserve channel interest even on a clean shutdown.
            <br />
            Note that this property has no effect for the case where an engine
            shuts down with
            an error (e.g. AepEngine.stop(Exception) with a non null cause. In this case channel
            joins are left in tact allowing a backup to take over.
            <br />
            Note that this behavior can be overridden programatically on a case
            by case basis
            by a handler for AepEngineStoppingEvent setting AepEngineStoppingEvent.setPreserveChannelJoins(boolean)
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="setSupportMetadata" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Enables setting of support related metadata on inbound
            and outbound messages.
            <p><br>
            Support related metadata is not critical to the operation of an engine and
            is set by the engine in inbound and
            outbound messages to aid in support and
            troubleshooting activities
            via the metadata being persisted in the service's
            transaction
            log. However, this setting of support related metadata information
            comes at a slight performance penalty (a couple of microseconds)
            that may not
            be tolerated by ultra low latency services. This
            property can be used to
            switch off the setting of support related metadata information in inbound and
            oubound messages for such
            performance critical services.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="setOutboundSequenceNumbers" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Disables setting of sequence numbers outbound
            messages. 
            <p><br>
            The setting of sequence
            numbers in outbound messages comes
            at a very slight performance penalty that may
            not be tolerated by ultra low latency services. This property can be used to
            switch off the setting of sequence numbers in oubound messages for such performance
            critical services. However, note that this effectively disables checking for
            duplicates for messages sent by
            such a configured engine by downstream apps.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="syncInjectedMessages" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets whether MessageView.sync() is called during AepEngine.injectMessage. 
            <p><br>
            When using Event Sourcing or inbound message logging injected messages 
            may be replicated and/or persisted to disk. To do so means that the contents of the message 
            must be synced. By doing sync() during the inject call, it can save the engine's processor 
            thread cpu cycles. 
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enableTypeBasedRouting" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets whether message type based routing is enabled or not
            <p><br>
            Without type based routing, a service has to be configured with the channels through which
            messages are exchanged with other services. Message are sent via channels and receiving
            services are configured to join channels to receive messages. With type based routing, the 
            services are able to communicate purely by message type with the X runtime automatically 
            setting up each configured bus for the service with the channels and subscriptions needed
            to facilitate the correct routing
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="stopOnJVMShutdown" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Sets whether the engine will automatically stop when the JVM shuts down
            <p><br>
            By default, the AEP engine registers a shutdown hook using which it automatically
            stops when the JVM shuts down. This property enables this behavior to be disabled.
            If set to false, the engine will not automatically stop when the JVM shuts down 
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
          If set to false, this service will be ignored and not saved to
          the configuration repository.
          <p><br>
          This can be used to omit an service at
          runtime. However,
          note that if a persistent configuration repository is
          in use,
          this will not cause a previously configured service to
          be deleted.
          ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
          Defines the service name which must be unique within an
          service's configuration
          domain.
          <p><br />
          A common practice for a clustered service is to use the same name
          for an service
          and its store. It is a best practice not to use a name
          with
          spaces as the name is used in many context such as scripting
          where it
          is operationally simpler to avoid spaces and special
          characters.
          ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="displayName" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    The friendly name for the service.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="discoveryDescriptor">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
        Configures a discovery descriptor.
        <br />
        <br />
        A discovery descriptor is of the form:
        <br />
        <br />
        provider://address[:port][&amp;properties]
        ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="provider" type="xs:string" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        The discovery provider's name which is used to locate the discovery implementation
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="address" type="xs:string" minOccurs="1" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        The discovery provider's address.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="port" type="xs:unsignedShort" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        The (optional) port.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="properties" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            List the discovery descriptor parameters in key=value pairs e.g.:<br><br>
             &lt;properties&gt;<br>
             &nbsp;&nbsp;&lt;username&gt;jane&lt;/username&gt;<br>
             &nbsp;&nbsp;&lt;single_session&gt;true&lt;/single_session&gt;<br>
             &lt;/properties&gt;
             ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="hierarchicalPropertySet">
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="jvmConfig">
        <xs:annotation>
            <xs:documentation>
                Configures a JVM
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="javaHome" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Configures the jvm's home directory which contains the bin/java executable to use.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="jvmParams" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
             A list of jvm parameters used to launch the jvm.
             <p>
             Parameters can be specified on a single line, or broken across 
             multiple lines for readability. When parameters are split across multiple lines 
             they are append to one another with a single whitespace character.
             </p>  
             <p>
             For Example:<br>
             &lt;jvm&gt;<br>
             &nbsp;&nbsp;&lt;jvmParams&gt;<br>
             &nbsp;&nbsp;&nbsp;&nbsp;-Xms8G -Xmx8g<br>
             &nbsp;&nbsp;&lt;/jvmParams&gt;<br>
             &lt;/jvm&gt;<br>
             </p> 
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="jvmParamSets" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            A list of named jvm parameters sets that are appended to generic jvmParams
            <p>
            Jvm parameter sets are useful in the context of config composition as they
            allow portions of jvm parameteres to be overridden by name based on active
            profiles or templates. 
            </p> 
            ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="jvmParamSet" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="jvmParams" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                         The jvm parameters to append for this jvm parameter set. 
                         <p>
                         Parameters can be specified on a single line, or broken across 
                         multiple lines for readability. When parameters are split across multiple lines 
                         they are append to one another with a single whitespace character.
                         </p>  
                         <p>
                         For Example:<br>
                         &lt;jvm&gt;<br>
                         &nbsp;&nbsp;&lt;jvmParamSets&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&lt;jvmParamSet name="verbose-gc" order="3"&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;jvmParams&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-verbose:gc<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-XX:+PrintGCDetails<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;/jvmParams&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&lt;/jvmParamSet&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&lt;jvmParamSet name="flight-recorder" order="2"&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;jvmParams&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-XX:+UnlockCommercialFeatures<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-XX:+FlightRecorder<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&lt;/jvmParams&gt;<br>
                         &nbsp;&nbsp;&nbsp;&nbsp;&lt;/jvmParamSet&gt;<br>
                         &nbsp;&nbsp;&lt;/jvmParamSets&gt;<br>
                         &lt;/jvm&gt;<br>
                         </p> 
                        ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                </xs:all>
                                <xs:attribute name="name" type="xs:string" use="required">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                        Sets the name of this set of jvm parameters. 
                        <p>
                        If a template is overridden or a profile is activated and the overridding
                        xml has a jvm param set with the same name, its jvm parameters will replace
                        those defined previously. 
                        </p>
                        ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="order" type="xs:short" use="optional" default="0">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                        Can be set to control the order in which the parameters from
                        this jvm parameter set are appended to the jvmParams for the 
                        jvm. Lower ordered jvm parameters are placed first. The ordering
                        for 2 parameter sets with the same order is unspecified. 
                        ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                        Can be set to false to disable the this set of jvm params. 
                        <p>
                        When a jvm param set is disabled its jvm parameters are not appended
                        to the jvm parameters string. 
                        </p>
                        ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="containerAdminChannelConfig">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
        Used to configure channels for container adminstration over a message bus. 
        ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
          Indicates whether or not the admin channel is enabled.
          ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="containerConfig">
        <xs:all>
            <xs:element name="env" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Defines environement variables scoped to the container.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="hierarchicalPropertySet">
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="provisioning" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Configures provisioning details for the container.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:all>
                        <xs:element name="host" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    Configures the host or ip address to which this container should be provisioned.
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="qualifyPathsWithSystem" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                When true (default), this setting indicates that installation paths should be appended
                with the /systemName/containerName. For example, if an installRoot is specified as '/usr/local/'
                a container named 'order-processor' in a system named 'order-processing-1.0' would be provisioned
                to '/usr/local/run/order-processing-1.0/order-processor'
                ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>

                        <xs:element name="rootDirectory" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                This is the root directory of the container's runtime sandbox. The sandbox is comprised 
                of three distinct sub-areas - a 'run' area, a 'data' area and a 'logs' area. The 
                'run' area is where the Rumi distribution and application jars are installed when 
                the container is provisioned. The 'data' area is the area containing binary application 
                data such as transaction logs. The 'logs' area contains container and contained service 
                trace logs. 
                </p>
                <p>
                This directory should be specified using only '/' characters for file separators.
                Provisioning tools are expected to perform path translations when deploying
                to windows systems. A path that starts with either '/' or contains a ':' character
                is interpreted as an absolute path. 
                </p>
                ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="runDirectory" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  The run directory is the root directory of the container 'run' area in the container's
                  runtime sandbox. This is the area where the Rumi distribution and application 
                  jars are installed. 
                  </p>
                  <p>
                  When specified as a relative pat, this path will be interpreted as being relative
                  to the resolved root directory.When not specified this defaults to 'run' subdirectory 
                  of the resolved root directory. 
                  </p>
                  <p>
                  This directory should be specified using only '/' characters for file separators.
                  Provisioning tools are expected to perform path translations when deploying
                  to windows systems. A path that starts with either '/' or contains a ':' character
                  is interpreted as an absolute path. 
                  </p>
                  ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="dataDirectory" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  The data directory is the root directory of the container 'data' area in the container's runtime. 
                  sandbox. This is the area where persistent data such as transaction logs are placed. 
                  It is good practice for applications to configure this area to be outside of the 'run' 
                  area so that re-provisioning of the application doesn't delete application data. 
                  </p>
                  <p>
                  When specified as a relative path, this path will be interpreted as being relative
                  to the resolved root directory.When not specified this defaults to 'rdat' subdirectory 
                  of the resolved root directory. 
                  </p>
                  <p>
                  This directory should be specified using only '/' characters for file separators.
                  Provisioning tools are expected to perform path translations when deploying
                  to windows systems. A path that starts with either '/' or contains a ':' character
                  is interpreted as an absolute path. 
                  </p>
                  ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="traceLogDirectory" type="xs:string" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  The trace log directory is the root directory of the container 'logs' area in the container's
                  runtime sandbox. This is the area where container and service logs are stored. It is good 
                  practice for applications to configure this areas to be outside of the 'run' area so 
                  that re-provisioning of the application doesn't delete application logs. 
                  </p>
                  <p>
                  When specified as a relative path, this path will be interpreted as being relative
                  to the resolved root directory. When not specified this defaults to 'logs' subdirectory 
                  of the resolved root directory. 
                  </p>
                  <p>
                  This directory should be specified using only '/' characters for file separators.
                  Provisioning tools are expected to perform path translations when deploying
                  to windows systems. A path that starts with either '/' or contains a ':' character
                  is interpreted as an absolute path. 
                  </p>
                  ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="jvm" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    Configures the jvm used to launch the container.
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:complexContent>
                                    <xs:extension base="jvmConfig">
                                    </xs:extension>
                                </xs:complexContent>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>

            <xs:element name="apps" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Configures that apps hosted by this container.
            <br />
            Multiple containers can host the same application. Each clustered
            application will discover its peers and form its own independent
            cluster. In other words containers don't cluster, but their applications,
            if configured with a store that has clustered enabled, do.
            ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="app" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>
                                    Adds an app defined in the apps section to this container.
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                      If set to false, the app will be ignored and not
                      saved to the configuration repository.
                      This can
                      be used to suppress addition of an application
                      at runtime.
                      <br />
                      However, note that if a persistent configuration
                      repository is in use, this will not
                      cause a
                      previously configured app for the this
                      container to
                      be removed.
                      ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="name" type="xs:string" use="required">
                                    <xs:annotation>
                                        <xs:documentation>
                                            The name of the application as defined in the 'apps' element.
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="autoStart" type="xs:boolean" use="optional" default="true">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                      Sets whether the container automatically starts the
                      app when the container is started.
                      <br />
                      If not set, then the application will be loaded
                      at container start, but it will not be
                      started
                      without an adminstrative command.
                      ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="acceptors" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Configures this container's acceptors. By default each
            container will create an acceptor
            on 'tcp://0.0.0.0:0' to listen on all
            interfaces at an auto assigned port (which is
            advertised). If an acceptor is defined explicitly for the container, the default acceptor
            is removed and replaced with the first defined acceptor.
            ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="acceptor" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>
                                    Defines and configures an acceptor.
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="linkParams" type="xs:string" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                A comma separate set of key=value pairs that serve as additional configuration parameters for the network connections accepted by this acceptor
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                </xs:all>
                                <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                      If set to false, the acceptor will
                      be ignored and not saved to the configuration
                      repository. 
                      <p><br>
                      This can be used to suppress
                      addition of an acceptor at runtime. However,
                      note that if a persistent configuration
                      repository is in use, this will not cause a
                      previously configured acceptor for the this
                      container to be removed.
                      ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="descriptor" type="xs:string" use="required">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                      Acceptor descriptors are of the form
                      [protocol]://[host]:[port]
                      e.g 'tcp://myhost:12000'and are used to specify the network protocol, interface and
                      protocol through which to accept inbound network connections requests. 
                      <p></br>
                      'tcp' is the
                      only currently support protocol, [host] can be the host name or IP address of a
                      specified interface on which this container will be running and the [port] is the
                      protocol specific container port on which the container will listed for inbound connections.
                      ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="multiThreading" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Configures the container's I/O threads.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:all>
                        <xs:element name="ioThreads" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    Configures the container's IO threads.
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="ioThread" minOccurs="0" maxOccurs="unbounded">
                                        <xs:complexType>
                                            <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        <![CDATA[
                            Whether or not this io
                            thread is enabled. If set to
                            disabled all I/O threads
                            with an id greate than this thread's id must also be disabled
                            ]]>
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="id" type="xs:nonNegativeInteger" use="required">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        The id of the thread. IO Thread ids are zero based and must be defined in monotonically increasing order.
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="affinity" type="xs:string" use="optional" default="0"/>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                    <xs:attribute name="enabled" type="xs:boolean" use="required">
                        <xs:annotation>
                            <xs:documentation>
                                <![CDATA[
                Whether or not container server multithreading is enabled.
                <br />
                In most cases this value should be set to true. Setting this
                value to false will set
                the IO thread count to 1 regardless
                of the number of
                IO threads listed for the container.
                ]]>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>

            <xs:element name="clientHandshakeTimeout" type="xs:positiveInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Sets the timeout used for allow connecting clients to complete the container connection.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="adminClientOutputQueueCapacity" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Configuration property used to set the capacity (in MB) for the size of the container controller 
            admin clients' output queue sizes. Outbound packets are dropped once the queue size reaches 
            and/or exceeds the configured capacity. 
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="autoStopOnAppStartFail" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
             Whether or not the container will automatically stop if any of its apps fails to start
             <p>
             Disabling auto stop on app start fail leaves the container running and managable even when one 
             or more of its applications have failed to start. The container will always fail to start if
             its admin app failed to start regardless of this setting.</p> 
             ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="autoStopOnLastAppStop" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
             Whether or not the container will automatically stop after the last app is stopped.
             <p>
             Disabling auto stop on last app stop leaves the container running and managable even when all 
             applications have stopped. The container's internal admin app does not count as a running app.</p> 
             ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="maxTraceHistory" type="xs:positiveInteger" minOccurs="0" maxOccurs="1" default="512">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
             Sets the maximum number of lines that are buffered for trace output for monitoring clients. 
             <p>
             An container buffers up to this number of trace lines to allow administrative applications time
             to connect and begin watching trace. This amount of trace history may be increased if lines
             of trace are missed by management applications.</p> 
             ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="discovery" type="discoveryDescriptor" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              Can be used instead of the discoveryDescriptor attribute to define a discovery
              provider to use with container discovery. This element cannot be used in conjuction
              with the discoveryDescriptor attribute, one or the other must be specified.
              <p>
              Server discovery is used to advertise a container's acceptors and applications.
              Specifying a unique discovery descriptor for container discovery is optional.
              When not specified the platform's default discovery provider will be used (which
              is specified by nv.discovery.descriptor environment variable).   
              </p>
              <p>
              See the discoveryDescriptor attribute's documentation for more details on container discovery. 
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>

            <xs:element name="heartbeatLogging" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Deprecated. Use logging element under the heartbeats element instead> 
            ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="messageLogger">
                            <xs:attribute name="enabled" type="xs:boolean" default="false">
                                <xs:annotation>
                                    <xs:documentation>
                                        Enables logging of heartbeats to disk.
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>

            <xs:element name="heartbeats" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Configures stats collection and heartbeats for the container.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:all>
                        <xs:element name="collectSeriesStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                   Configures whether series stats are collected in heartbeats. 
                   <p>
                   Latencies statistics and other series type statistics are more cpu and bandwidth
                   intensive to collect and emit. This property can be set to false to disable their 
                   collection.  
                   </p>
                   ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="collectSeriesDatapoints" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                   Configures whether series stats datapoints are included in heartbeats. 
                   <p>
                   Series statistics such as latencie statistics are reported as histogram when series
                   stats collection is enabled. Enabling this property also includes the collected datapoints.
                   </p>
                   <p>
                   Enabling this property can be extremely bandwidth intensive and is not typically recommended.
                   </p>
                   ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="maxTrackableSeriesValue" type="xs:int" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                       Deprecated. This field is not used any more 
                   ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="poolDepletionThreshold" type="xs:float" minOccurs="0" maxOccurs="1" default="1.0">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  Configuration property used to set the percentage decrement at which a preallocated pool 
                  must drop to be included in a container heartbeat. 
                  <p>
                  Normal pool stats are only included in a heartbeat if there were pool misses in the interval.
                  For preallocated pools, however, misses are not expected until the preallocated items are 
                  exhausted. For such pools it is generally of interested from a monitoring perspective to
                  observer the rate of depletion of such items.
                  </p> 
                  <p>
                  If a pool is preallocated with 1000 items and this property is set to 10, pool stats will be 
                  emitted for the pool when its size drops below 900, 800, 700, until its size reaches 0 (at which 
                  point subsequent misses would cause it to be included on every heartbeat). 
                  </p>
                  <p>
                  Setting this to a value greater than 100 or less than or equal to 0 disables depletion threshold 
                  reporting. 
                  </p>
                  ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="collectPoolStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                   Configures whether pool stats are collected and reported in heartbeats. 
                   <p>
                   When pool stats are enabled pool stats are included for pools that experienced a pool
                   miss in the collection interval, or preallocated pool items falls below a 
                   poolDepletionThreshold. 
                   </p>
                   <p>
                   For applications that don't expect to operate in a zero garbage mode, this can be 
                   disbaled to prevent hearbeats from becoming too large.
                   </p>
                   ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="collectAllPoolStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                   Configures whether all pool stats are collected and reported in heartbeats. 
                   <p>
                   When pool stats are enabled, only pools that experienced a pool miss in the
                   collection interval or preallocated pool items falls below the pool depletion 
                   threshold are included in the heartbeats. This property configured the server
                   such that stats for all pools are included in the heartbeats regardless of 
                   whether the pool experienced the above changes across heartbeats. 
                   </p>
                   ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="collectIndividualThreadStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                   Configures whether individual thread stats are collected. 
                   <p>
                   Collecting stats for individual threads can lead to larger heartbeats. For
                   aplications that don't need such stats this collection can be disabled. 
                   </p>
                   ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="collectNonZGStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  Sets whether or not stats that produce garbage as a result of being collected are enabled. 
                  <p>
                  Some stats involve using reflection or 3rd party apis that create garbage. 
                  This property can be set to false to suppress collection of those stats. 
                  Currently the list of stats that may produce garbage include: 
                  <ul>
                  <li>Process and System CPU usage. When disabled processor and system cpu usage may be returned as -1.</li> 
                  <li>Enhanced disk usage statistics. When disabled heartbeats will fall back to reporting the space 
                  for disk roots returned from File.getRoots().</li>  
                  </ul>
                 ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="includeMessageTypeStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  Sets whether or not message type stats are included in heartbeats (when enabled for the app).  
                  <p>
                  When captureMessageTypeStats is enabled for an app, the AepEngine will record select statistics on a per
                  message type basis. Because inclusion of per message type stats can significantly increase the size of 
                  heartbeats, inclusion in heartbeats is disabled by default. 
                  </p><p>
                  <i>Note: For message type stats to be included in heartbeats, both captureMessageTypeStats for the app
                  must be set to true (capture is disabled by default because recording them is costly), and includeMessageTypeStats
                  must be set to true (inclusion is disabled by default because emitting them is costly).</i> 
                 ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="inactiveMessageTypeStatsInclusionFrequency" type="xs:integer" minOccurs="0" maxOccurs="1" default="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  When configured to include message type stats, controls how frequently inactive message types are reported 
                  <p>
                  By default when message type stats are included in heartbeats, all message types are included in each heartbeat 
                  regardless of whether there was any activity for that type in the collection interval. This approach ensures 
                  that no message types are missed when a monitoring application starts monitoring after messaging activity has
                  occurred, but comes at the cost of increasing the size of heartbeats when there are a large number of message 
                  types that have infrequent activity. 
                  </p><p>
                  This setting allows reducing the frequency (in number of heartbeats) at which to include inactive message types
                  in heartbeats. A value of 1 (the default) causes inactive message types to be included on every heartbeat, 
                  a value less than or equal to 0 causes inactive types to never be included, a value of 5 causes inactive types 
                  to be included on every 5th hearbeat and so on.
                 ]]>
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="tracing" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                 Configures tracing of heartbeats.
                 <p>
                 Note that while collection and emission of heartbeats is zero garbage
                 tracing of stats is not zero garbage. Enabling of stats trace in a container
                 is provided for convenience for profiling or debugging, but is not recommended
                 in production for latency sensitive applications. A better alternative is to
                 log hearbeats to disk and trace them out of process using the stats dump tool. 
                 </p>
                 ]]>
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="traceAdminClientStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                        <xs:annotation>
                                            <xs:documentation>
                                                Controls whether admin client stats are traced (when tracing is enabled).
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="traceAppStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                        <xs:annotation>
                                            <xs:documentation>
                                                Controls whether app stats are traced (when tracing is enabled).
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="tracePoolStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                        <xs:annotation>
                                            <xs:documentation>
                                                Controls whether pool stats are traced (when tracing is enabled).
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="traceSysStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                        <xs:annotation>
                                            <xs:documentation>
                                                Controls whether system stats are traced (when tracing is enabled).
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="traceThreadStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                        <xs:annotation>
                                            <xs:documentation>
                                                Controls whether thread stats are traced (when tracing is enabled).
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                    <xs:element name="traceUserStats" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                        Controls whether user app stats are traced (when tracing is enabled).
                        <p>
                        If traceAppStats is enabled then user stats are reported as part of the
                        application stats unless this property is disabled. 
                        </p>
                        <p>
                        If traceAppStats is false then this proprery can be used to trace only the 
                        user stats. 
                        </p>
                        ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                    </xs:element>
                                </xs:all>
                                <xs:attribute name="enabled" type="xs:boolean" use="optional" default="false">
                                    <xs:annotation>
                                        <xs:documentation>
                                            Indicates whether container tracing is enabled. When set to false no stats are traced.
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="logging" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    Configures logging of container heartbeats to disk.
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:complexContent>
                                    <xs:extension base="messageLogger">
                                        <xs:attribute name="enabled" type="xs:boolean" default="false">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    Enables logging of heartbeats to disk.
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:attribute>
                                    </xs:extension>
                                </xs:complexContent>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                    <xs:attribute name="enabled" type="xs:boolean" use="optional" default="false">
                        <xs:annotation>
                            <xs:documentation>
                                Indicates whether container heartbeats are enabled.
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="interval" type="xs:long" use="optional" default="30">
                        <xs:annotation>
                            <xs:documentation>
                                Indicates the container heartbeat interval in seconds.
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>

            <xs:element name="admin" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Configures admininstration and monitoring capabilities of the container.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:all>
                        <xs:element name="passiveMonitoringOnly" type="xs:boolean" default="false" minOccurs="0" maxOccurs="1">
                        </xs:element>
                        <xs:element name="transports" minOccurs="0" maxOccurs="1">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  Configures transports available for container monitoring and control.
                  ]]>
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="direct" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                         Configuration for direct (tcp) based monitoring and control connections. 
                         ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                            <xs:attribute name="enabled" type="xs:boolean" default="true">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        Enables direct monitoring and control connections.
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>
                                    <xs:element name="sma" minOccurs="0" maxOccurs="1">
                                        <xs:annotation>
                                            <xs:documentation>
                                                <![CDATA[
                         Configures the Admin over SMA transport used for monitoring and control over SMA.
                         ]]>
                                            </xs:documentation>
                                        </xs:annotation>
                                        <xs:complexType>
                                            <xs:all>
                                                <xs:element name="busName" type="xs:string" minOccurs="0" maxOccurs="1" default="true">
                                                    <xs:annotation>
                                                        <xs:documentation>
                                                            <![CDATA[
                              The name of the bus (defined in the global buses section) used for monitoring over SMA.
                              ]]>
                                                        </xs:documentation>
                                                    </xs:annotation>
                                                </xs:element>
                                                <xs:element name="channels" minOccurs="0" maxOccurs="1">
                                                    <xs:annotation>
                                                        <xs:documentation>
                                                            Configures admin bus channels.
                                                        </xs:documentation>
                                                    </xs:annotation>
                                                    <xs:complexType>
                                                        <xs:all minOccurs="0" maxOccurs="1">
                                                            <xs:element name="request" minOccurs="0" maxOccurs="1">
                                                                <xs:annotation>
                                                                    <xs:documentation>
                                                                        Specifies the channel used to receive admin requests on the admin messaging bus.
                                                                    </xs:documentation>
                                                                </xs:annotation>
                                                                <xs:complexType>
                                                                    <xs:complexContent>
                                                                        <xs:extension base="containerAdminChannelConfig"/>
                                                                    </xs:complexContent>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="response" minOccurs="0" maxOccurs="1">
                                                                <xs:annotation>
                                                                    <xs:documentation>
                                                                        Specifies the channel used to send admin responses on the admin messaging bus.
                                                                    </xs:documentation>
                                                                </xs:annotation>
                                                                <xs:complexType>
                                                                    <xs:complexContent>
                                                                        <xs:extension base="containerAdminChannelConfig"/>
                                                                    </xs:complexContent>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="heartbeat" minOccurs="0" maxOccurs="1">
                                                                <xs:annotation>
                                                                    <xs:documentation>
                                                                        Specifies the channel used to publish heartbeats over the admin message bus.
                                                                    </xs:documentation>
                                                                </xs:annotation>
                                                                <xs:complexType>
                                                                    <xs:complexContent>
                                                                        <xs:extension base="containerAdminChannelConfig"/>
                                                                    </xs:complexContent>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="trace" minOccurs="0" maxOccurs="1">
                                                                <xs:annotation>
                                                                    <xs:documentation>
                                                                        Specifies the channel used to publish trace over the admin messaging bus.
                                                                    </xs:documentation>
                                                                </xs:annotation>
                                                                <xs:complexType>
                                                                    <xs:complexContent>
                                                                        <xs:extension base="containerAdminChannelConfig"/>
                                                                    </xs:complexContent>
                                                                </xs:complexType>
                                                            </xs:element>
                                                            <xs:element name="event" minOccurs="0" maxOccurs="1">
                                                                <xs:annotation>
                                                                    <xs:documentation>
                                                                        Specifies the channel used to publish events over the admin messaging bus..
                                                                    </xs:documentation>
                                                                </xs:annotation>
                                                                <xs:complexType>
                                                                    <xs:complexContent>
                                                                        <xs:extension base="containerAdminChannelConfig"/>
                                                                    </xs:complexContent>
                                                                </xs:complexType>
                                                            </xs:element>
                                                        </xs:all>
                                                    </xs:complexType>
                                                </xs:element>
                                                <xs:element name="keyResolutionTable" minOccurs="0" maxOccurs="1">
                                                    <xs:annotation>
                                                        <xs:documentation>
                                                            <![CDATA[
                              List the key resolution properties to use for substitution in messages sent 
                              over admin bus channels.
                              <p>
                              Example:
                              <p>
                               &lt;keyResolutionTable&gt;<br>
                               &nbsp;&nbsp;&lt;environment&gt;PROD&lt;/username&gt;<br>
                               &nbsp;&nbsp;&lt;single_session&gt;true&lt;/single_session&gt;<br>
                               &lt;/keyResolutionTable&gt;<br>
                              </p>
                               ]]>
                                                        </xs:documentation>
                                                    </xs:annotation>
                                                    <xs:complexType>
                                                        <xs:complexContent>
                                                            <xs:extension base="hierarchicalPropertySet">
                                                            </xs:extension>
                                                        </xs:complexContent>
                                                    </xs:complexType>
                                                </xs:element>
                                            </xs:all>
                                            <xs:attribute name="enabled" type="xs:boolean" default="false">
                                                <xs:annotation>
                                                    <xs:documentation>
                                                        Enables monitoring over SMA.
                                                    </xs:documentation>
                                                </xs:annotation>
                                            </xs:attribute>
                                        </xs:complexType>
                                    </xs:element>
                                </xs:all>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                </xs:complexType>
            </xs:element>
        </xs:all>
        <xs:attribute name="enabled" type="xs:boolean" use="optional" default="true">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
          If set to false, this container will be ignored and not saved
          to the configuration repository.
          This can be used to disable a container at
          runtime. However,
          note that if a persistent configuration repository is
          in use,
          this will not cause a previously configured container to be deleted.
          ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="name" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
          Defines the container name which must be unique within the container's
          configuration domain.
          <br />
          A common practice is to use a container name that is indicative of the
          application or
          set of applications that it is hosting and the normal
          application
          role. For example of the container will host shard 1 of order
          processing app that normally assumes the primary role a name
          such as
          "order-processing-p-1" might be used. In this fashion
          an instance of an
          application can be uniquely addressed with
          a discovery domain as a
          combination of the container name and
          app name.
          <br />
          It is a best practice not to use a name with spaces as the name is used
          in many context
          such as scripting where it is operationally simpler to
          avoid
          spaces and special characters.
          ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="displayName" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    The friendly name for the container.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="group" type="xs:string" use="optional" default="default">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
          Defines the container's application group.
          <br />
          An application group is purely an organizational contruct that groups
          containers that together fulfill a given role.
          ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="discoveryDescriptor" type="xs:string" use="optional">
            <xs:annotation>
                <xs:documentation>
                    <![CDATA[
          Defines the container's discovery descriptor.
          <br />
          The discovery descriptor which is used to load and configure the
          discovery provider used to advertise this container and its acceptors.
          Setting this property is only useful when the intent is to separate out
          container discovery from cluster discovery. When not set, the
          default discovery descriptor set in the global environment
          will be used (which is simpler and sufficient for most usecases).
          <br />
          Server discovery is important for administrative applications to be able
          to locate running applications to allow monitoring and command and
          control.
          <br />
          A container must have a unique name with its discovery domain.
          <br />
          Note that when the p2p message bus binding is used, the discovery
          descriptor for the container must be part of the same discovery domain as
          the default discovery descriptor configured via nv.discovery.descriptor
          because the container itself facilitates advertising and accepting point to
          point connections.
          ]]>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="messageLogger">
        <xs:annotation>
            <xs:documentation>
                Configures a message logger.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="flushOnCommit" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Whether or not the logger should be flushed on commit.
            <br />
            By default the logger buffers writes into an internal
            buffer and doesn't write to
            disk until that buffer has
            filled. Enabling flush
            on commit will flush the logger
            regardless of whether
            the buffer has filled.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="flushUsingMappedMemory" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Whether flushes to the log file should be performed using a memory mapped file buffer
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="autoFlushSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            In the absense of explicit flushes (e.g. flushOnCommit)
            of written entries, the size
            at which flush is
            automatically triggered for queued
            writes.
            <br />
            If not set specified the platform default (8192) is used.
            <p>
            When no unit suffix is specified the value is interpreted as being in bytes.
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="autoRepair" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Whether or not an attempt will be made to
            automatically repair a non empty log on
            open by
            truncating malformed entries at the end of
            the log that
            are part of incomplete transactions.
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storeRoot" type="xs:string" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Specifies the root folder in which the logger's transaction log files are located.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="initialLogLength" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1" default="1mb">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            <p>
            Sets the initial file size of logger's transaction log
            </p>
            <br />
            <p>
            Preallocating the transaction log can save costs in
            growing the file size over time
            since the operation of
            growing a log file may actually
            results in a write of
            file data + the metadata operation
            of updating the file
            size, and may also benefit from
            allocating contiguous
            sectors on disk.
            </p>
            <br />
            <p>
            When no unit suffix is specified the value is interpreted as being in gigabytes
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="zeroOutInitial" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Whether the log file should be explictly zeroed out (to force commit all disk pages) if newly created.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="pageSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Sets the page size for the disk in bytes. The logger will use this as a hint in several areas to optimize its operation.
                        <p>
                            When not specified the plaform will use its default page size of 8kb.
                        </p>
                        <p>
                            When no unit suffix is specified the value is interpreted as being in bytes.
                        </p>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="detachedWrite" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Configures whether or not logger writes are done by the committing thread thread or passed off to a detached writer thread. Offloading to a writer thread can increase application throughput but requires an extra processor core for the logger thread.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:group ref="EventMultiplexerProperties"/>
                    <xs:attribute name="enabled" type="xs:boolean" use="optional"/>
                </xs:complexType>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:complexType name="compactionConfig">
        <xs:annotation>
            <xs:documentation>
                Configures compaction for a store persister.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="compactOnStart" type="xs:boolean" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              Specifies whether compaction should be triggered on startup.
              </p>
              <p>
              Setting this value to true will cause compaction to be triggered automatically when
              a log is opened. This compaction is done prior to app state initialization. 
              </p>
              <p>
              Log Compaction is currently only applicable to applications using StateReplication as an
              HAPolicy.
              </p>        
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="compactionThreshold" type="byteLength" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            <p>
            Sets the log compaction threshold.
            </p>
            <p>
            The log compaction threshold is the size that triggers a log compaction.
            The act of compacting a log will compact as many complete checkpoints in the log and
            switch the live log over to the compacted log. A threshold value of less than or equal
            to 0 disables live log compaction.
            </p>
            <p>
            Log Compaction is currently only applicable to applications using StateReplication as an
            HAPolicy.
            </p>        
            <p>
            When no unit suffix is specified the value is interpreted as being in megabytes.
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="maxCompactionWindowSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            <p>
            The log compaction window is the approximate maximum size in bytes rounded up
            to the end of the nearest checkpoint that a compact operation uses to determine how many
            log entries it will hold in memory. The more entries the compactor can hold in memory
            while performing a compaction, the more efficient the compact operation will be.
            </p>
            <p>
            <b>Note:</b> The minimum compaction window is a checkpoint. Therefore, if the system is
            configured such that a checkpooint covers entries that cumulatively exceeds the value
            of this parameter, then this parameter will not reduce the compaction memory usage - the
            compator will load the entire checkpoint into memory when performing the checkpoint operation. 
            </p>
            <p>
            <b>Note:</b> When estimating memory needed by the compaction operation, one
            should multiply this parameter by a factor of 2 i.e. the memory used by compaction will be
            twice the memory specified via this parameter
            </p>
            <p>
            Log Compaction is currently only applicable to applications using StateReplication
            as an HAPolicy.
            </p>        
            <p>
            <i>This property is not used, and should not be specified when conflateCheckpoints is 
            enabled. 
            </p>
            <p>
            When no unit suffix is specified the value is interpreted as being in megabytes.
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="entryRetentionThreshold" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              The maximum number of read entries that should be held in memory while preparing the compacted set of entries. 
              </p>
              <p>
              The compaction reader will retain references to entries it reads from the log up to this threshold. When the 
              threshold is exceeded the the reader will only retain a pointer to the entry in the file which 
              will be loaded on demand as needed by the handler.
              </p>
              <p> 
              Specifying a higher value results in faster access time for entries, but has higher memory overhead.
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="conflateCheckpoints" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              Specifies that the checkpoint reader should conflate checkpoints prior to dispatching to the handler. 
              </p>
              <p>
              When set to true, this flag will cause the checkpoint reader to conflate entries into a single checkpoint dispatched
              to the ReadHandler. At most one entry will be dispatched to the ReadHandler per object, and Send and
              Remove entries won't be dispatched at all. 
              </p>
              <p> 
              When set to false, this flag will cause the checkpoint reader to dispatch each checkpoint to the compactor
              allowing it to do incremental compaction in accordance with the configured maxCompactionWindowSize, which 
              results in multiple compaction runs being done to fully compact the log, but can result in less memory
              usage by the compactor. 
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="offheapBuffering" type="xs:boolean" minOccurs="0" maxOccurs="1" default="false">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              Indicates whether or not non-retained entries should be sorted and buffered into an off heap buffer after conflation. 
              </p>
              <p>
              When this flag is set, and the number of entries loaded by the reader exceeds that set by 'entryRetentionThreshold',
              the compacted set of entries are sorted and loaded into an off heap memory buffer prior to dispatch to the handler. 
              </p>
              <p> 
              This can result in a significant increase in performance as buffering and retrieval of the entries can be done in a 
              sequential fashion. Enabling this will result in the allocation of buffer space equivalent to the size of the entries 
              on disk to be dispatched to the handler in a checkpoint (or if 'conflateCheckpoints' is set, the size of the conflate
              entry set). It is important to note that this will not result in the actual entries being loaded, so this does not incur 
              the expense of java object overhead that would be incurred with a large value for 'entryRetentionThreshold'.
              </p>
              <b>Note on Memory Usage:</b> Enabling offheap buffering pre loads the compacted data into to memory prior to writing
              out the new transaction log. This memory is allocated off heap, but must be accounted for as part of the target hosts
              total memory footpint. 
              <p>
              In addition the off heap memory used, the heap memory usage used by offheap buffering corresponds to the overhead of 
              the number of buffers used to buffer the data (see offHeapBufferingPageSize) which is roughly 250 bytes per buffer.  
              </p>        
              <p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="offheapBufferingLoadStrategy" type="OffheapBufferingLoadStrategy" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              When off heap buffering is enabled, how to load sorted entries into off heap memory. 
              </p>
              <p>
              When off heap buffering is enabled, entries that were not retained are loaded into memory after being conflated and sorted. 
              This property controls the mechanism use to load the conflated entries into memory prior to disatch to the handler. 
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="offheapBufferingMaxPageSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              Indicates the maximum size (in bytes) of each of the buffers to use to hold off heap entries. 
              </p>
              <p>
              As entries are stored off heap memory new buffers are serialized in off heap pages with a maximum size given by this property. 
              </p>
              <p> 
              The maximum allowable value of this property is Integer.MAX_VALUE, and the minimum value is 8kb.
              </p>
              <p>
              When no unit is provided this value is interpreted in bytes. 
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="memMappedReadBufferMaxSize" type="nonNegativeByteLength" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              When 'offheapBufferingLoadStrategy' is set to 'MemoryMappedRead', controls the maximum size of the file to map into memory at a time. 
              </p>
              <p>
              The maximum supported value in Integer.MAX_VALUE. 
              </p>
              <p>
              When no unit is provided this value is interpreted in bytes. 
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="properties" type="hierarchicalPropertySet" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              Can be used to specify advanced tuning properties for the compactor. 
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>


    <xs:complexType name="cdcConfig">
        <xs:annotation>
            <xs:documentation>
                Configures compaction for a store persister.
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="entryRetentionThreshold" type="xs:nonNegativeInteger" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              The maximum number of read entries that should be held in memory while processing checkpoints set of entries. 
              </p>
              <p>
              The cdc checkpoint reader will retain references to entries it reads from the log up to this threshold. When the 
              threshold is exceeded the reader will only retain a pointer to the entry in the file which 
              will be loaded on demand as needed by the handler.
              </p>
              <p> 
              Specifying a higher value results in faster access time for entries, but has higher memory overhead.
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="skipCdcCheckpointed" type="xs:boolean" minOccurs="0" maxOccurs="1" default="true">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              Flag indicating the the compaction reader should skip over entries with a checkpoint version higher than the log's 
              current CdcCheckpointVersion. 
              </p>
              <p>
              When set this will cause the compaction reader to skip over entries below the CdcCheckpoint version which 
              reduces the memory overhead and read time. Disabling this property provides better log integrity checks by
              ensuring that allow entries up to those being dispatched are consistent. 
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="properties" type="hierarchicalPropertySet" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
              <p>
              Can be used to specify advanced tuning properties for the compactor. 
              </p>
              ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>

    <xs:simpleType name="providerName">
        <xs:restriction base="xs:string">
            <xs:pattern value="([a-z][a-z0-9+\-.]+)"/>
            <xs:maxLength value="32"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="identifier">
        <xs:restriction base="xs:string">
            <xs:pattern value="(\.|:|-|_|\w)+"/>
            <xs:maxLength value="256"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="displayName">
        <xs:annotation>
            <xs:documentation>
                A human readable friendly display name.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:maxLength value="256"/>
        </xs:restriction>
    </xs:simpleType>


    <xs:simpleType name="duration">
        <xs:annotation>
            <xs:documentation>
                A time duration string optionally suffixed with a duration unit (e.g. 10s or 1h))
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\.{0,1}[\d,.]+\s{0,1}([a-zA-Z]+){0,1}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="byteLength">
        <xs:annotation>
            <xs:documentation>
                A number of bytes followed by a unit (b,kb,gb,tb)
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[+-]{0,1}\.{0,1}[\d,.]+\s{0,1}([a-zA-Z]+){0,1}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="nonNegativeByteLength">
        <xs:annotation>
            <xs:documentation>
                A number of bytes followed by a unit (b,kb,gb,tb)
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\.{0,1}[\d,.]+\s{0,1}([a-zA-Z]+){0,1}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="versionNumber">
        <xs:annotation>
            <xs:documentation>
                A version number. A version number can be compared to another version number by legigraphical comparison of of the array of strings that result from splitting the version number by the '.' character.
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:maxLength value="128"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="systemDetails">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
        Holds metadata for the system described by this deployment descriptor. 
        <p>
        System details are used by deployment and monitoring tools to identify 
        the system. 
        </p>
        ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="name" type="identifier" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            The unique identifier for the system described by this deployment descriptor.
            <p>
            The identifier should be a short, descriptive identifier that allows it and the
            collection of container and applications it groups together. When this element isn't
            specified, parsers should interpreted the system name to be that of document
            that defines
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="displayName" type="displayName" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        A human readable name for the system intended for use by tools.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="version" type="versionNumber" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            The version of this system.
            <p>
            A system version should be incremented as changes are made to
            the configuration or composition of the system (container and apps).
            </p>
            ]]>
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:all>
    </xs:complexType>


    <xs:complexType name="busProviderList">
        <xs:annotation>
            <xs:documentation>
                <![CDATA[
        <p>
        The 'busProviders' section is optional and allows registration of custom message bus implementations.
        </p>
        When working with custom message binding types, a messaging provider implementing com.neeve.sma.MessagingProvider 
        must be registered with the runtime to serve as a factory for creating new message bus instances.
        </p>
        <p>
        Providers are registered by name and must match the providerName used when configuring the bus (or as the scheme 
        portion of the message bus desciptor)
        </p>
        <p> 
        To avoid conflicts with potential future bus implementations provided by the platform itself, it is recommended 
        that user prefix custom provider names with a prefix such as 'x-' to mark the binding as a custom bus extension. 
        For example, if you were to implement a bus binding that communicates over amqp (which is not current implemented 
        by the platform) use 'x-amqp' as the binding name.
        </p> 
        ]]>
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="provider" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        <![CDATA[
            Defines and registers a custom message bus provider.
            ]]>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="busProvider"/>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="busConfigList">
        <xs:annotation>
            <xs:documentation>
                Defines the buses used in the system.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="templates" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Defines a Talon Server application templates.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="bus" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                    Defines a message bus template.
                    <p>
                    Template buses cannot be used at runtime they serve only as 
                    templates for actual buses' configuration.
                    </p>
                    ]]>
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:complexContent>
                                    <xs:extension base="busConfig"/>
                                </xs:complexContent>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="bus" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="busConfig">
                            <xs:attribute name="template" type="xs:string" use="optional">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                      Specifies the template on which to base this bus. The bus will
                      inherit the configuration from the template, overriding any values with
                      those it specifies. 
                      ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="serviceConfigList">
        <xs:annotation>
            <xs:documentation>
                A list of configured Talon applications.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="templates" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Defines a Talon Server application templates.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="app" minOccurs="0" maxOccurs="unbounded">
                            <xs:annotation>
                                <xs:documentation>
                                    <![CDATA[
                  Defines a Talon Server application template.
                  <p>
                  Template applications cannot be used at runtime they serve only as 
                  templates for actual apps' configuration
                  </p>
                  ]]>
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:complexContent>
                                    <xs:extension base="serviceConfig">
                                        <xs:attribute name="mainClass" type="xs:string" use="optional">
                                            <xs:annotation>
                                                <xs:documentation>
                                                    <![CDATA[
                          Specifies the application's main class (e.g. com.acme.MyApplication).
                          <br />
                          An application's main class serves as the main entry point for a Talon
                          Server application.
                          ]]>
                                                </xs:documentation>
                                            </xs:annotation>
                                        </xs:attribute>
                                    </xs:extension>
                                </xs:complexContent>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="app" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Defines a Talon Server application.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:complexContent>
                        <xs:extension base="serviceConfig">
                            <xs:attribute name="mainClass" type="xs:string" use="optional">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                    Specifies the application's main class (e.g. com.acme.MyApplication).
                    <br />
                    An application's main class serves as the main entry point for a Talon
                    Server application.
                    <br />
                    This element is option if the mainClass is supplied by a template.
                    ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>
                            <xs:attribute name="template" type="xs:string" use="optional">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                    Specifies the template on which to base this app. The app will
                    inherit the configuration from the template, overriding any values with
                    those it specifies. 
                    ]]>
                                    </xs:documentation>
                                </xs:annotation>
                            </xs:attribute>
                        </xs:extension>
                    </xs:complexContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="containerConfigList">
        <xs:annotation>
            <xs:documentation>
                Defines the Rumi containers used in the system.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="templates" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Defines Talon Server application templates.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:choice>
                            <xs:element name="container" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            Defines a Rumi container template.
                                            <p>
                                            Template containers cannot be used at runtime. They serve only as templates for actual containers' configuration
                                            </p>
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:complexContent>
                                        <xs:extension base="containerConfig"/>
                                    </xs:complexContent>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="xvm" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            DEPRECATED (use <container> instead)
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:complexContent>
                                        <xs:extension base="containerConfig"/>
                                    </xs:complexContent>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="server" minOccurs="0" maxOccurs="unbounded">
                                <xs:annotation>
                                    <xs:documentation>
                                        <![CDATA[
                                            DEPRECATED (use <container> instead)
                                        ]]>
                                    </xs:documentation>
                                </xs:annotation>
                                <xs:complexType>
                                    <xs:complexContent>
                                        <xs:extension base="containerConfig"/>
                                    </xs:complexContent>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:choice>
                <xs:element name="container" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            Defines and configures a Rumi Container.
                        </xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:complexContent>
                            <xs:extension base="containerConfig">
                                <xs:attribute name="template" type="xs:string" use="optional">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                Specifies the template on which to base this container. The container will
                                                inherit the configuration from the template, overriding any values with
                                                those it specifies. 
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:extension>
                        </xs:complexContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="xvm" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            DEPRECATED - (use &lt;container&gt; instead)
                        </xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:complexContent>
                            <xs:extension base="containerConfig">
                                <xs:attribute name="template" type="xs:string" use="optional">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                DEPRECATED - Use the <container> element instead. 
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:extension>
                        </xs:complexContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="server" minOccurs="0" maxOccurs="unbounded">
                    <xs:annotation>
                        <xs:documentation>
                            DEPRECATED - (use &lt;container&gt; instead)
                        </xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:complexContent>
                            <xs:extension base="containerConfig">
                                <xs:attribute name="template" type="xs:string" use="optional">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <![CDATA[
                                                DEPRECATED - Use the <container> element instead. 
                                            ]]>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:extension>
                        </xs:complexContent>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
        </xs:sequence>
    </xs:complexType>

    <xs:element name="model">
        <xs:annotation>
            <xs:documentation>
                Defines buses, apps and containers that are deployed and managed as a single system.
            </xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:all>
                <xs:element name="systemDetails" minOccurs="0" maxOccurs="1">
                    <xs:annotation>
                        <xs:documentation>
                            <![CDATA[
              Holds metadata for the system described by this deployment descriptor. 
              <p>
              System details are used by deployment and monitoring tools to identify 
              the system. 
              </p>
              ]]>
                        </xs:documentation>
                    </xs:annotation>
                    <xs:complexType>
                        <xs:complexContent>
                            <xs:extension base="systemDetails"/>
                        </xs:complexContent>
                    </xs:complexType>
                </xs:element>
                <xs:element name="env" minOccurs="0" maxOccurs="1">

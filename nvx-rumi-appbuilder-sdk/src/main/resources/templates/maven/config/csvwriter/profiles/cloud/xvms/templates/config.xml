<xvm name="{{ServiceName}}-template">
    <env>
        <SERVICE_HEAP_SIZE_PARAMS>${{{AppTokenName}}.local.heap.{{ServicePackageName}}::-Xms32m -Xmx1g}</SERVICE_HEAP_SIZE_PARAMS>
        <SERVICE_TELEMTRY_ENABLE>true</SERVICE_TELEMTRY_ENABLE>
    </env>
    <provisioning>
        <jvm>
            <javaHome>${{{AppTokenName}}.java.home::%JAVA_HOME_11%}</javaHome>
            <jvmParamSets>
                <jvmParamSet name="java-11-opens" order="0">
                    <jvmParams>--add-opens=java.base/jdk.internal.ref=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.management/sun.management=ALL-UNNAMED --illegal-access=warn</jvmParams>
                </jvmParamSet>
            </jvmParamSets>
        </jvm>
    </provisioning>
</xvm>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<model xmlns="http://www.neeveresearch.com/schema/x-ddl">
    <env>
        <nv>
            <stats>
                <memory>
                    <enable>true</enable>
                    <type>
                        <enable>true</enable>
                    </type>
                </memory>

                <latency>
                    <waypoint>
                        <global>
                            <enabled>true</enabled>
                        </global>
                    </waypoint>
                    <leg>
                        <global>
                            <enabled>true</enabled>
                        </global>
                        <messaging>
                            <type>
                                <enabled>true</enabled>
                            </type>
                        </messaging>
                    </leg>
                </latency>
            </stats>
        </nv>
        <{{AppTokenName}}>
        </{{AppTokenName}}>
    </env>
    <buses>
        <bus name="{{BusName}}" descriptor="${APP_BUS_DESCRIPTOR}"/>
    </buses>
    <apps>
        <templates>
        </templates>
    </apps>
    <xvms>
        <templates>
        </templates>
    </xvms>
    <profiles>
        <!-- In-process integration testing (see src/test/.../AbstractTest.java).
             Activated explicitly by tests via the nv.ddl.profiles=test property.
             Uses a loopback message bus and loopback discovery so no broker or
             networking is needed; per-service heartbeats already default off and
             services run single-instance, non-clustered. -->
        <profile name="test">
            <env>
                <ROOT_DIR>target/testbed</ROOT_DIR>
                <APP_BUS_DESCRIPTOR>loopback://{{AppTokenName}}</APP_BUS_DESCRIPTOR>
                <SERVICE_STORE_LOCATION>${ROOT_DIR}/store/${nv.ddl.targetxvm}</SERVICE_STORE_LOCATION>
                <nv>
                    <discovery.descriptor>loopback://.&amp;initWaitTime=0</discovery.descriptor>
                </nv>
                <{{AppTokenName}}>
                </{{AppTokenName}}>
            </env>
        </profile>
        <profile name="cloud">
            <activation>
                <properties>
                    <rumi.agent.env>cloud</rumi.agent.env>
                </properties>
            </activation>
            <env>
                <ROOT_DIR>${{{AppTokenName}}.rootdir::/home/rumi/{{AppTokenName}}}</ROOT_DIR>
                <APP_BUS_DESCRIPTOR>{{MessagingConnectionString}}</APP_BUS_DESCRIPTOR>
                <SERVICE_STORE_LOCATION>${ROOT_DIR}/store/${nv.ddl.targetxvm}</SERVICE_STORE_LOCATION>
                <nv>
                    <!-- discovery -->
                    <discovery.descriptor>activemq://discovery.rumi.local:61616?wireFormat.maxInactivityDuration=0</discovery.descriptor>
                </nv>

                <{{AppTokenName}}>
                </{{AppTokenName}}>
            </env>
            <apps>
                <templates>
                </templates>
            </apps>
            <xvms>
                <templates>
                </templates>
            </xvms>
        </profile>
    </profiles>
</model>

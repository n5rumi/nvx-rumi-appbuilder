<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <name>Rumi App Builder Parent</name>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>nvx-rumi-appbuilder-parent</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>

    <parent>
        <groupId>com.neeve</groupId>
        <artifactId>nvx-os-parent</artifactId>
        <version>1.1.6</version>
    </parent>

    <organization>
        <name>N5 Technologies, Inc</name>
        <url>http://www.n5corp.com</url>
    </organization>

    <licenses>
        <license>
            <name>Apache 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/n5rumi/nvx-rumi-appbuilder</url>
        <connection>scm:git:git://github.com/n5rumi/nvx-rumi-appbuilder.git</connection>
    </scm>

    <properties>
        <!-- The Rumi milestone this builder targets. Single source of truth:
             the REST service compiles against it, and the SDK unpacks its
             schemas (x-ddl, x-adml, x-asml) from the matching artifacts at
             build time. A milestone bump is this one line. -->
        <nvx.rumi.version>4.0.660</nvx.rumi.version>
    </properties>

    <modules>
        <module>nvx-rumi-appbuilder-sdk</module>
        <module>nvx-rumi-appbuilder-rest</module>
        <!-- nvx-rumi-appbuilder-mcp is Python (pyproject.toml) — not a Maven module -->
    </modules>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Java 11 -->
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.8.1</version>
                    <configuration>
                        <release>11</release>
                    </configuration>
                </plugin>

                <!-- Makes `versions:update-properties` do the milestone bump, and
                     only the milestone bump.

                     Two problems this solves. First, nvx.rumi.version lives here
                     in the parent while the dependency that uses it
                     (com.neeve:nvx-rumi) lives in the REST module, so the plugin's
                     auto-linking found nothing to associate at the aggregator and
                     silently left the property alone — a milestone bump appeared to
                     succeed while pinning the previous milestone. The explicit
                     association below is that missing link.

                     Second, everything else here is deliberately hand-managed. The
                     pinned plugin (2.1, from nvx-os-parent) predates ignoredVersions,
                     so it happily proposes milestone and alpha artifacts — it has
                     offered jersey 4.0.0-M2 and slf4j 2.1.0-alpha1. includeProperties
                     confines it to the one property a milestone is allowed to move;
                     the locked jetty/jersey/jackson/swagger/slf4j pins in
                     nvx-rumi-appbuilder-rest stay hand-edited, as documented in
                     CLAUDE.md. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <configuration>
                        <includeProperties>nvx.rumi.version</includeProperties>
                        <properties>
                            <property>
                                <name>nvx.rumi.version</name>
                                <dependencies>
                                    <dependency>
                                        <groupId>com.neeve</groupId>
                                        <artifactId>nvx-rumi</artifactId>
                                    </dependency>
                                </dependencies>
                            </property>
                        </properties>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Exclude header checking/formatting of all template files in any module -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>2.9</version>
                <executions>
                    <execution>
                        <id>format-headers</id>
                    </execution>
                    <execution>
                        <id>check-headers</id>
                    </execution>
                </executions>
                <configuration>
                    <strictCheck>false</strictCheck>
                    <excludes>
                        <exclude>**/src/main/resources/templates/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>rumi-public</id>
            <url>https://nexus.n5corp.com/repository/maven-public/</url>
            <name>Rumi Repository</name>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>rumi-public</id>
            <url>https://nexus.n5corp.com/repository/maven-public/</url>
            <name>Rumi Repository</name>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <releases>
                <enabled>true</enabled>
            </releases>
        </pluginRepository>
    </pluginRepositories>
</project>
